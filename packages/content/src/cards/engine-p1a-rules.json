  "rules": [
    {
      "id": "paired-taizuo-ming",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "三台八座成對會命",
      "when": {
        "all": [
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "三台"
          },
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "八座"
          }
        ]
      },
      "sources": [
        "wtz.deep.p317.b008",
        "wtz.deep.p317.b009",
        "wtz.deep.p317.b010",
        "wtz.deep.p317.b011"
      ],
      "conditions": [
        "三台、八座均須在命宮三方四正實際成對會照；三組命宮都有原節所列天府或天梁。",
        "不以單見其中一星，代替成對前提。"
      ],
      "exceptions": [
        "原節另分父母宮正曜吉否、輔佐單星及桃花；夫妻宮原局不吉時可加強不利性質，均不移作本人命宮結論。"
      ],
      "explanation": "本盤具台座成對會照的位置條件，原書把這一組視為儀仗、地位方面的修飾，與恩光天貴的受獎勵性質分開。"
    },
    {
      "id": "paired-engui-ming",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "恩光天貴成對會命",
      "when": {
        "all": [
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "恩光"
          },
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "天貴"
          }
        ]
      },
      "sources": [
        "wtz.deep.p318.b009",
        "wtz.deep.p318.b010",
        "wtz.deep.p318.b011",
        "wtz.deep.p318.b012",
        "wtz.deep.p318.b013",
        "wtz.deep.p318.b014",
        "wtz.deep.p318.b015"
      ],
      "conditions": [
        "兩星均須實際在命宮三方四正；單星位置仍保留，不宣稱單星完全無作用。",
        "紫微、天府、太陰、太陽同會是原文「最喜」的修飾，不把所有主星配合寫成同樣力量。"
      ],
      "exceptions": [
        "夾事業宮還須魁鉞加夾；夫妻宮得妻財另須疊祿；與昌曲交會利考試，不由恩貴一項保證結果。"
      ],
      "explanation": "成對恩貴提供的是獎勵、認可及隨之而來的實際助力，不能與台座單純增加地位的性質混寫。"
    },
    {
      "id": "paired-taifeng-ming",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "台輔封誥同會核對",
      "when": {
        "all": [
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "台輔"
          },
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "封誥"
          }
        ]
      },
      "sources": [
        "wtz.deep.p319.b008",
        "wtz.deep.p319.b009",
        "wtz.deep.p319.b010",
        "wtz.deep.p319.b011",
        "wtz.deep.p318.b015"
      ],
      "conditions": [
        "兩曜可各自起作用，本卡只核兩者同會的充分條件；不把它定成所有作用必須成對。台輔偏精神、聲望，封誥偏物質、封贈，分開保存。",
        "科文同會、事業及財帛宮是原文另列的修飾與主語。"
      ],
      "exceptions": [
        "命宮或六親宮另有煞忌刑耗重重、又有昌曲會合的事件分支；本輪保留定位及前提，不實作存亡推斷。"
      ],
      "explanation": "這組位置讓聲望與實際獎授分開對照；不把得到認同直接等同收入或職位已經提升。"
    },
    {
      "id": "paired-longfeng-ming",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "龍池鳳閣成對會命",
      "when": {
        "all": [
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "龍池"
          },
          {
            "sanfangOf": {
              "name": "命宮"
            },
            "contains": "鳳閣"
          }
        ]
      },
      "sources": [
        "wtz.deep.p317.b013",
        "wtz.deep.p317.b014",
        "wtz.deep.p317.b015",
        "wtz.deep.p317.b016",
        "wtz.deep.p317.b017",
        "wtz.deep.p317.b018",
        "wtz.deep.p318.b001"
      ],
      "conditions": [
        "兩星實際成對會入命宮三方四正，才採成對才藝修飾。",
        "昌曲、魁鉞同會可增加力量；清貴與富貴不同，不直接推出收入。"
      ],
      "exceptions": [
        "夾財帛／事業宮另有輔弼或昌曲加夾條件；317.b015原提取「更不」字樣待原頁核實，未建立該分支。",
        "七殺命宮／疾厄的老年分支另須流煞沖起，本條不推健康或感官結果。"
      ],
      "explanation": "命宮具龍鳳成對會照，可按原書保留才藝、文采的修飾；這項配合不能直接當成財富或整體能力評分。"
    },
    {
      "id": "paired-longfeng-wellbeing",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "龍鳳成對會福德",
      "when": {
        "all": [
          {
            "sanfangOf": {
              "name": "福德"
            },
            "contains": "龍池"
          },
          {
            "sanfangOf": {
              "name": "福德"
            },
            "contains": "鳳閣"
          }
        ]
      },
      "sources": [
        "wtz.deep.p317.b013",
        "wtz.deep.p317.b014",
        "wtz.deep.p317.b016",
        "wtz.deep.p565.b006",
        "wtz.deep.p565.b007",
        "wtz.deep.p565.b010"
      ],
      "conditions": [
        "龍池、鳳閣均須在福德三方四正有本命實坐位置；不將對宮整組星永久搬進福德。",
        "此處主語是精神享受、思想與興趣，不能替代命宮整局的本質判斷。"
      ],
      "exceptions": [
        "福德與財帛必須分開，不能由精神方面的才藝修飾保證進財。",
        "昌曲、魁鉞加強一項另核；本條不新增智力、心理或疾病評級。"
      ],
      "explanation": "福德已有龍鳳成對會照，精神生活可以多讀文藝、才藝與興趣這一面；這比只說是否安逸更具體，也不等於已證明某項才華或收入。",
      "focus": "福德"
    },
    {
      "id": "huagai-wellbeing",
      "groups": [
        "tongliang",
        "tianfu",
        "jiliang"
      ],
      "title": "華蓋實坐福德",
      "when": {
        "star": "華蓋",
        "in": {
          "name": "福德"
        }
      },
      "sources": [
        "wtz.deep.p318.b017",
        "wtz.deep.p321.b008",
        "wtz.deep.p321.b009",
        "wtz.deep.p321.b010",
        "wtz.deep.p321.b011",
        "wtz.deep.p321.b012",
        "wtz.deep.p565.b010"
      ],
      "conditions": [
        "先確認華蓋實坐福德；只採原書把華蓋偏向哲理、可輔助命宮對讀的範圍。",
        "見科文、見空曜是不同附加條件；本條沒有以華蓋單星斷定特別見解或宗教信仰。"
      ],
      "exceptions": [
        "華蓋章標題及首句有原檔疑字，定位沿既有導讀，原字不擅改。",
        "重病者命宮的儀仗分支不移作本條福德判讀。"
      ],
      "explanation": "華蓋實坐福德，新增的是思想、哲理與文藝興趣的閱讀角度；仍要與同宮及會照的實際星曜分開交代。",
      "focus": "福德"
    },
    {
      "id": "tongliang-new-principle",
      "groups": [
        "tongliang"
      ],
      "title": "同梁新增原則修飾逐項留證",
      "when": {
