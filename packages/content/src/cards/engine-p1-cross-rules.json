{
  "version": "engine-p1-cross-rules-v1",
  "date": "2026-10-24",
  "pdf_sha256": "513e3d068040efe3684eb3c0e44cf6e447787670bbf5d618f022da2d6c55231b",
  "rules": [
    {
      "id": "tl-four-frame",
      "groups": [
        "tongliang"
      ],
      "title": "同梁的取捨、天機的工作、太陰的財與太陽的福",
      "palaces": [
        "命宮",
        "官祿",
        "財帛",
        "福德"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "star": "天同",
            "in": {
              "name": "命宮"
            }
          },
          {
            "star": "天梁",
            "in": {
              "name": "命宮"
            }
          },
          {
            "star": "天同",
            "at": [
              "寅",
              "申"
            ]
          },
          {
            "star": "天機",
            "in": {
              "name": "官祿"
            }
          },
          {
            "star": "太陰",
            "in": {
              "name": "財帛"
            }
          },
          {
            "star": "太陽",
            "in": {
              "name": "福德"
            }
          }
        ]
      },
      "sources": [
        "wtz.deep.p087.b010",
        "wtz.deep.p087.b011",
        "wtz.deep.p087.b012",
        "wtz.deep.p087.b013"
      ],
      "explanation": "同梁的感受與原則放在命宮看；實際工作另看天機的應變，財帛看太陰的計劃與積聚，福德再看太陽的活動與精神追求。四宮各有角色，不能用一個性格詞概括全盤。",
      "conditions": [
        "同梁實坐寅申命宮，官祿天機、財帛太陰、福德太陽均須實坐。"
      ],
      "exceptions": [
        "浪漫與原則的偏向仍須配曜、四化及調和；本條不選定任一極端。"
      ]
    },
    {
      "id": "tl-work-changing",
      "groups": [
        "tongliang"
      ],
      "title": "官祿天機對巨門：變動與費心機",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "star": "天機",
            "in": {
              "name": "官祿"
            }
          },
          {
            "star": "天機",
            "at": [
              "子",
              "午"
            ]
          },
          {
            "opposite": [
              "天機",
              "巨門"
            ]
          }
        ]
      },
      "sources": [
        "wtz.deep.p522.b005",
        "wtz.deep.p522.b006",
        "wtz.deep.p522.b011",
        "wtz.deep.p523.b004"
      ],
      "explanation": "工作較多變動，要隨問題、客戶或任務調整；子午天機對巨門又加上費心機的一面。這是在講工作如何進行，未等於已確定職稱或一定轉工。",
      "conditions": [
        "天機實坐子午官祿，與巨門相對。"
      ],
      "exceptions": [
        "吉曜吉化可修飾前途；化祿亦不把多變完全消去。流動客戶與任務只是原書職業性質的解說。"
      ]
    },
    {
      "id": "tl-design-same-palace",
      "groups": [
        "tongliang"
      ],
      "title": "規劃設計專長另查同度條件",
      "palaces": [
        "官祿"
      ],
      "role": "branch",
      "when": {
        "all": [
          {
            "star": "天機",
            "in": {
              "name": "官祿"
            }
          },
          {
            "meets": "天機",
            "stars": [
              "文昌",
              "文曲",
              "天才"
            ],
            "reach": "same"
          }
        ]
      },
      "sources": [
        "wtz.deep.p523.b003"
      ],
      "explanation": "官祿天機同度昌曲或天才，才有這一條規劃設計的專門支持。",
      "conditions": [
        "天機守官祿；昌曲或天才須同度，會照不代替同度。"
      ],
      "exceptions": [
        "沒有這項組合不等於不能從事設計，只代表本條未提供專門支持。"
      ]
    },
    {
      "id": "tl-wealth-planning",
      "groups": [
        "tongliang"
      ],
      "title": "財帛太陰：用計劃累積，與福德對讀",
      "palaces": [
        "官祿",
        "財帛",
        "福德"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "star": "太陰",
            "in": {
              "name": "財帛"
            }
          },
          {
            "star": "太陰",
            "at": [
              "辰",
              "戌"
            ]
          },
          {
            "star": "太陽",
            "in": {
              "name": "福德"
            }
          },
          {
            "opposite": [
              "太陰",
              "太陽"
            ]
          }
        ]
      },
      "sources": [
        "wtz.deep.p451.b009",
        "wtz.deep.p451.b010",
        "wtz.deep.p451.b011",
        "wtz.deep.p452.b008"
      ],
      "explanation": "這裡的求財重點在計劃、安排與累積，不是只看一次收入高低。太陰在財、太陽在福相對，也要分開資源怎樣累積，與本人怎樣追求和享用。",
      "conditions": [
        "太陰實坐辰戌財帛，對宮福德太陽。"
      ],
      "exceptions": [
        "辰戌有別；廟陷、日夜及祿權科等原書分支未全部啟用，不能由本條直接定富貴。"
      ]
    },
    {
      "id": "tl-wealth-tongji",
      "groups": [
        "tongliang"
      ],
      "title": "同忌會財帛太陰：求財的耗力",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
            "all": [
              {
                "star": "太陰",
                "in": {
                  "name": "財帛"
                }
              },
              {
                "star": "太陰",
                "at": [
                  "辰",
                  "戌"
                ]
              },
              {
                "star": "太陽",
                "in": {
                  "name": "福德"
                }
              },
              {
                "opposite": [
                  "太陰",
                  "太陽"
                ]
              }
            ]
          },
          {
            "star": "天同",
            "in": {
              "name": "命宮"
            }
          },
          {
            "star": "天同",
            "hua": "忌"
          },
          {
            "sanfangOf": {
              "name": "財帛"
            },
            "contains": "天同"
          }
        ]
      },
      "sources": [
        "wtz.deep.p452.b008",
        "wtz.deep.p452.b009",
        "wtz.deep.p452.b010"
      ],
      "explanation": "命宮天同忌會到辰戌太陰財帛，原書對這支講的是勞心勞力求財。跟官祿天機連讀，重點便是工作要反覆應變，財的累積也要投入心力；不能只寫成懂規劃就自然輕鬆得財。",
      "conditions": [
        "財帛為辰戌太陰；天同本命化忌，且實際會照財帛。"
      ],
      "exceptions": [
        "天機忌的奔波、太陽忌的是非是另外兩支；不把天同忌搬成天機忌或太陰忌。"
      ]
    },
    {
      "id": "tl-wealth-yanglu",
      "groups": [
        "tongliang"
      ],
      "title": "福德陽祿對財：先建立位置，再談財路",
      "palaces": [
        "財帛",
        "福德"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
            "all": [
              {
                "star": "太陰",
                "in": {
                  "name": "財帛"
                }
              },
              {
                "star": "太陰",
                "at": [
                  "辰",
                  "戌"
                ]
              },
              {
                "star": "太陽",
                "in": {
                  "name": "福德"
                }
              },
              {
                "opposite": [
                  "太陰",
                  "太陽"
                ]
              }
            ]
          },
          {
            "star": "太陽",
            "hua": "祿"
          }
        ]
      },
      "sources": [
        "wtz.deep.p452.b009",
        "wtz.deep.p452.b010"
      ],
      "explanation": "辰戌太陰會太陽祿，原書把先建立地位、再發展財源列為一個次序。放回本盤，是先在工作中累積位置與資源再談財路；同忌帶來的耗力仍然存在。",
      "conditions": [
        "財帛辰戌太陰，對宮太陽本命化祿。"
      ],
      "exceptions": [
        "任職後自創是原書一般取向，不是創業指令、時間預測或保證發財；不能把陽祿當作太陰化祿。"
      ]
    },
    {
      "id": "tl-rest-active",
      "groups": [
        "tongliang"
      ],
      "title": "福德太陽與鈴星：有追求不等於容易停下",
      "palaces": [
        "命宮",
        "財帛",
        "福德"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
            "star": "太陽",
            "in": {
              "name": "福德"
            }
          },
          {
            "star": "鈴星",
            "in": {
              "name": "福德"
            }
          }
        ]
      },
      "sources": [
        "wtz.deep.p569.b011",
        "wtz.deep.p565.b009",
        "wtz.deep.p565.b010"
      ],
      "explanation": "福德太陽偏向活動與追求，鈴星又令心神較難安定。連着求財的投入看，這盤要分清做得有成績，與內心是否真的得到休息；藝術趣味另可作精神投入的方向。",
      "conditions": [
        "太陽、鈴星實坐福德；藝術方向須另核昌曲龍鳳等配曜，不由此條保證。"
      ],
      "exceptions": [
        "不是疾病、焦慮症或實際情緒的診斷；廟陷、日夜、配曜仍會修飾。"
      ]
    },
    {
      "id": "tl-rest-day-branch",
      "groups": [
        "tongliang"
      ],
      "title": "太陽福德較安靜的分支仍缺日夜前提",
      "palaces": [
        "福德"
      ],
      "role": "branch",
      "when": {
        "star": "太陽",
        "in": {
          "name": "福德"
        }
      },
      "sources": [
        "wtz.deep.p569.b011",
        "wtz.deep.p570.b002",
        "wtz.deep.p570.b003"
      ],
      "explanation": "日生及輔弼台座等會合條件要另行核實，未能由太陽祿便說成安靜有福。",
      "conditions": [
        "原文分日生夜生及輔弼台座會合。"
      ],
      "exceptions": [
        "目前沒有已校勘的日夜判讀輸入；不拿出生鐘點自行代替。"
      ],
      "gates": [
        {
          "kind": "manual",
          "id": "reviewed-day-night-and-assistants",
          "description": "日夜前提與原文配曜組合尚未完成可執行校核"
        }
      ]
    },
    {
      "id": "tf-store",
      "groups": [
        "tianfu"
      ],
      "title": "命宮天府有祿：資源管理與守成的基礎",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "star": "天府",
            "in": {
              "name": "命宮"
            }
          },
          {
            "star": "天府",
            "at": [
              "巳",
              "亥"
            ]
          },
          {
            "any": [
              {
                "together": [
                  "天府",
                  "祿存"
                ]
              },
              {
                "star": "天府",
                "hua": "祿"
              }
            ]
          }
        ]
      },
      "sources": [
        "wtz.deep.p020.b003",
        "wtz.deep.p020.b004",
        "wtz.deep.p020.b005",
        "wtz.deep.p430.b009"
      ],
      "explanation": "命宮天府有祿，先有可用的庫藏支持；它較直接講理財、儲財與管理資源，不能等同每次都能生出新財。官祿天相要回頭看這個府庫，才看得清責任背後有甚麼資源。",
      "conditions": [
        "天府實坐巳亥命宮，祿存同度或天府化祿；本批採可明確定位的保守有祿條件。"
      ],
      "exceptions": [
        "相的夾宮、煞忌與露庫另核；有祿支持不是對全部格局已作充盈且無牽制的判定。"
      ]
    },
    {
      "id": "tf-career-role",
      "groups": [
        "tianfu"
      ],
      "title": "官祿天相回看命宮府庫",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "star": "天相",
            "in": {
              "name": "官祿"
            }
          },
          {
            "star": "天相",
            "at": [
              "卯",
              "酉"
            ]
          },
          {
            "star": "天府",
            "in": {
              "name": "命宮"
            }
          }
        ]
      },
      "sources": [
        "wtz.deep.p544.b008",
        "wtz.deep.p545.b005",
        "wtz.deep.p545.b009",
        "wtz.deep.p545.b015"
      ],
      "explanation": "官祿天相的重點是受託、協調與承擔權責；有職權亦要看背後的資源。跟命宮天府連讀，比籠統說穩定更具體：一邊管理庫藏，一邊在組織中把事情接住和執行。",
      "conditions": [
        "天相實坐卯酉官祿，天府實坐命宮；財的成色仍須府所會合星曜。"
      ],
      "exceptions": [
        "副貳是原書職務性質，不是現代職稱上限；不能直接斷定某人做不了最高負責人。"
      ]
    },
    {
      "id": "tf-career-ke",
      "groups": [
        "tianfu"
      ],
      "title": "有祿府科連官祿天相：技術性工作的線索",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
            "all": [
              {
                "star": "天相",
                "in": {
                  "name": "官祿"
                }
              },
              {
                "star": "天相",
                "at": [
                  "卯",
                  "酉"
                ]
              },
              {
                "star": "天府",
                "in": {
                  "name": "命宮"
                }
              }
            ]
          },
          {
            "all": [
              {
                "star": "天府",
                "in": {
                  "name": "命宮"
                }
              },
              {
                "star": "天府",
                "at": [
                  "巳",
                  "亥"
                ]
              },
              {
                "any": [
                  {
                    "together": [
                      "天府",
                      "祿存"
                    ]
                  },
                  {
                    "star": "天府",
                    "hua": "祿"
                  }
                ]
              }
            ]
          },
          {
            "star": "天府",
            "hua": "科"
          }
        ]
      },
      "sources": [
        "wtz.deep.p020.b003",
        "wtz.deep.p201.b008",
        "wtz.deep.p545.b010"
      ],
      "explanation": "卯酉天相遇有祿的天府化科，原書把工程技術列作工作性質的方向。這使本盤的受託管理可以再收窄到較重技術、規範與可核對成果的工作線索，並非只剩空泛的管理兩字。",
      "conditions": [
        "卯酉天相官祿；命宮天府具本批有祿位置，且本命化科。"
      ],
      "exceptions": [
        "只列工作性質線索，不承諾資格、能力或職業成果；壬科伴武忌與輔佐眾多的整體評價仍另核，不由本條定祥和。"
      ]
    },
    {
      "id": "tf-career-authority",
      "groups": [
        "tianfu"
      ],
      "title": "官祿天相會紫微權：權責與實得分開",
      "palaces": [
        "命宮",
        "官祿",
        "財帛"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
            "all": [
              {
                "star": "天相",
                "in": {
                  "name": "官祿"
                }
              },
              {
                "star": "天相",
                "at": [
                  "卯",
                  "酉"
                ]
              },
              {
                "star": "天府",
                "in": {
                  "name": "命宮"
                }
              }
            ]
          },
          {
            "star": "紫微",
            "hua": "權"
          },
          {
            "sanfangOf": {
              "name": "官祿"
            },
            "contains": "紫微"
          }
        ]
      },
      "sources": [
        "wtz.deep.p544.b014",
        "wtz.deep.p545.b005"
      ],
      "explanation": "天相官祿會紫微權，原書提醒名與權可重於直接財利；所以職權、責任與最後實得要分開看，不能把職位當作收入或滿足的同義詞。",
      "conditions": [
        "天相官祿，實際會照本命紫微權。"
      ],
      "exceptions": [
        "見煞另有弄權與挫折的修飾；本條不指當事人正在弄權或已發生事件。"
      ]
    },
    {
      "id": "tf-wealth-reference",
      "groups": [
        "tianfu"
      ],
      "title": "財帛空宮借福德武貪：同一來源的兩面",
      "palaces": [
        "命宮",
        "財帛",
        "福德"
      ],
      "role": "basis",
      "when": {
        "all": [
          {
            "empty": {
              "name": "財帛"
            }
          },
          {
            "star": "武曲",
            "in": {
              "name": "福德"
            }
          },
          {
            "star": "貪狼",
            "in": {
              "name": "福德"
            }
          }
        ]
      },
      "sources": [
        "wtz.deep.p201.b001",
        "wtz.deep.p429.b008",
        "wtz.deep.p430.b008"
      ],
      "explanation": "財帛沒有實坐主星，借對宮福德的武貪作求財性質參照。兩宮共用同一組主星來源，宜一起看追求資源的動力與實際求財方式，不能算成兩次獨立命中。",
      "conditions": [
        "財帛空宮，借宮標記指向福德；武曲貪狼實坐福德。"
      ],
      "exceptions": [
        "武曲忌與配曜仍在福德；未把原生財帛武貪的所有富貴、暴發或破敗分支移入。"
      ],
      "borrow": {
        "target": "財帛",
        "origin": "福德",
        "stars": [
          "武曲",
          "貪狼"
        ]
      }
    },
    {
      "id": "tf-rest-wuji",
      "groups": [
        "tianfu"
      ],
      "title": "武曲忌在福德：有資源與知足是兩題",
      "palaces": [
        "命宮",
        "財帛",
        "福德"
      ],
      "role": "modifier",
      "when": {
        "all": [
          {
