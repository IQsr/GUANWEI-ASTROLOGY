{
  "pdf_sha256": "513e3d068040efe3684eb3c0e44cf6e447787670bbf5d618f022da2d6c55231b",
  "locations": {
    "wtz.deep.p042.b005": {
      "page": 42,
      "section": "紫微獨坐子午",
      "sha256": "3a3979e47178c21cab2838457fae12d7466a3f563857f4a53de99f73bc60c147",
      "excerpt": [
        "精神与物质的平衡。"
      ]
    },
    "wtz.deep.p042.b006": {
      "page": 42,
      "section": "紫微獨坐子午",
      "sha256": "fc1d36eb542c961649e480a44a5db77157590775eaa1b73264da69c617d93d2e",
      "excerpt": [
        "紫微本身，既有属于精神方面的本质",
        "亦有属于物质方面的性质"
      ]
    },
    "wtz.deep.p045.b004": {
      "page": 45,
      "section": "破軍獨坐寅申",
      "sha256": "1e6a582844e77549628f7d8e2559297c73066e018c258ee978d28681d96d86cc",
      "excerpt": [
        "此破军的叛逆性与顺从性。"
      ]
    },
    "wtz.deep.p045.b006": {
      "page": 45,
      "section": "破軍獨坐寅申",
      "sha256": "153825ab8902be4d250dc870e8ba63f32e54ebf2590b1516f7e51ec8bd3f4248",
      "excerpt": [
        "判断破军的叛逆性与顺从性，即可判断此[马鞍形]运势的升降度。"
      ]
    },
    "wtz.deep.p047.b011": {
      "page": 47,
      "section": "廉貞天府坐辰戌",
      "sha256": "7c28f6f434060ce883c3021ffbfba34ba684e6f8d151fe40b2fb21b3bdcfdceb",
      "excerpt": [
        "廉贞本身，已经是带有感情与理智冲突矛盾的星曜"
      ]
    },
    "wtz.deep.p048.b001": {
      "page": 48,
      "section": "廉貞天府坐辰戌",
      "sha256": "a243784154727b78dde8b47abb37de043e210a8fe73242a24a5d840a3addc72f",
      "excerpt": [
        "充满感情与理智冲突的结果。"
      ]
    },
    "wtz.deep.p048.b002": {
      "page": 48,
      "section": "廉貞天府坐辰戌",
      "sha256": "c24d898f72581f83e5966c3cad02c2b54092822c4fb9c50e1fb9ce2510358f05",
      "excerpt": [
        "当天府同垣时，并不能使感情或理智定向"
      ]
    },
    "wtz.deep.p050.b007": {
      "page": 50,
      "section": "太陰獨坐巳亥",
      "sha256": "17e1d5eedd6ac0de54048b5e7a8a4dd8ed29dfed816865ff2938d993a7a42ebd",
      "excerpt": [
        "太阴以收敛为佳",
        "但亦不宜过份收敛"
      ]
    },
    "wtz.deep.p051.b004": {
      "page": 51,
      "section": "太陰獨坐巳亥",
      "sha256": "edc8b17b9af2b71b4a58a37a90854517fe9f1b2faaa08ed2652c73fc397a66d6",
      "excerpt": [
        "太阴重收敛，但并非喜欢过度收敛，必须有适度的发射，然后始为[英华内敛]。"
      ]
    },
    "wtz.deep.p051.b006": {
      "page": 51,
      "section": "太陰獨坐巳亥",
      "sha256": "95b179e86c992667e4bdb473333a7420e6f077ee783dae5da198fecb9777d065",
      "excerpt": [
        "最好的太阴结构，是收敛性略重，而又有适度的发射。"
      ]
    },
    "wtz.deep.p053.b006": {
      "page": 53,
      "section": "貪狼獨坐子午",
      "sha256": "2eae85fd88126b7af1f73d7c8957265dc31ba506e71cb2e00d49faab062206b8",
      "excerpt": [
        "要评断此贪狼的本质，须分别它的欲望强弱。当欲望强烈时，又须分别为对物欲的强烈，抑或是对情欲的强烈。"
      ]
    },
    "wtz.deep.p054.b002": {
      "page": 54,
      "section": "貪狼獨坐子午",
      "sha256": "6de81568b11ad0e7e8b8ed78954b952515ad3aac5a02a57eaedd4fbbd6f51645",
      "excerpt": [
        "人生不宜欲望过高，亦不宜欲望过低。"
      ]
    },
    "wtz.deep.p354.b004": {
      "page": 354,
      "section": "貪狼",
      "sha256": "18db2d67d096beea44919d855fb7287c95e7129dac21358c739f5ea3e75a6d23",
      "excerpt": [
        "贪狼与空曜、天刑同躔，",
        "主端正。",
        "唯仍不喜地劫同躔，主挫折。"
      ]
    },
    "wtz.deep.p353.b011": {
      "page": 353,
      "section": "貪狼",
      "sha256": "767b12211ac5bae049ad34ba7fd3dea7daef6d98ac30c98358bb97b1c19a5298",
      "excerpt": [
        "由于贪狼表现为物欲的争取，所以又成为擅长交际应酬的表征。然其交际必倾向于酒色财气。"
      ]
    },
    "wtz.deep.p355.b002": {
      "page": 355,
      "section": "貪狼",
      "sha256": "a287f1a08ae0c5f938eae414ece4702ed19aa6ef08b1169aa590233f78c5dbea",
      "excerpt": [
        "凡贪狼，皆以七杀、破军、太阴、太阳、巨门、紫微宫垣为大运流年之枢纽。"
      ]
    },
    "wtz.deep.p056.b004": {
      "page": 56,
      "section": "天同巨門坐丑未",
      "sha256": "c6a6a292f27a69ba07b650a81dfb4a533833823de968ddcae5fe8ed15d043c8a",
      "excerpt": [
        "因为巨门为暗曜，天同为情绪之星",
        "便须注意其阴暗的程度。"
      ]
    },
    "wtz.deep.p056.b007": {
      "page": 56,
      "section": "天同巨門坐丑未",
      "sha256": "86415587f19373536947e61e79583b0cbf51be13983a64e2c21fe7070502bd68",
      "excerpt": [
        "因此两相比较，丑宫的[同巨]，阴暗较小，未宫的[同巨]，阴暗较大。"
      ]
    },
    "wtz.deep.p056.b011": {
      "page": 56,
      "section": "天同巨門坐丑未",
      "sha256": "3c0c35e510cf895301ec04ead937134073b81341cec9aec566d7991cd488bfde",
      "excerpt": [
        "明朗的[同巨]，比较上不畏煞曜",
        "阴暗的[同巨]，则畏煞曜"
      ]
    },
    "wtz.deep.p058.b013": {
      "page": 58,
      "section": "武曲天相坐寅申",
      "sha256": "4da92375c10607f97b6947639b10fa912d4ec57b84bd2b6de9570c7636d1a12e",
      "excerpt": [
        "要推断这个星系的本质，须注意刚柔的配合与调和。武曲性刚，天相性柔"
      ]
    },
    "wtz.deep.p059.b001": {
      "page": 59,
      "section": "武曲天相坐寅申",
      "sha256": "0865714ae6737bdfb4afc28f20e797c3b17a4177b0327177495242daaa47020c",
      "excerpt": [
        "必须刚柔互济，然后始成佳构，若过刚过柔，都可能出现缺点"
      ]
    },
    "wtz.deep.p060.b006": {
      "page": 60,
      "section": "武曲天相坐寅申",
      "sha256": "38528ac64a5dd441d6ca25c4c090a63aa7a3bf287a807d4f0b189c7852f70d0d",
      "excerpt": [
        "本性过刚的[武相]再行刚决的宫垣，便主人生多挫折失败",
        "本性过柔相的[武相]，再行柔弱的宫垣，便主冷退，或受人排挤。"
      ]
    },
    "wtz.deep.p060.b007": {
      "page": 60,
      "section": "武曲天相坐寅申",
      "sha256": "b87201d8e059e99ed911ee4c68f8cb7e67a25cd65498de0bd109c9e93555263e",
      "excerpt": [
        "若刚柔相济的[武曲天相]，行经刚柔相济的宫垣",
        "即使经行过刚过柔的宫垣，亦不过为一时的挫折，或者是一时的受制"
      ]
    },
    "wtz.deep.p061.b005": {
      "page": 61,
      "section": "太陽天梁坐卯酉",
      "sha256": "3fa4cbb26de06591cf5f5f7a6b9b10b806b85b842d435bf55bd321a72f8adaa3",
      "excerpt": [
        "要推断[太阳天梁]的本质，须分别其为祥和抑为孤忌。"
      ]
    },
    "wtz.deep.p062.b001": {
      "page": 62,
      "section": "太陽天梁坐卯酉",
      "sha256": "786ce50cfcc4e7e5725863002f2a4ca62668c685c49f74aec7cc86bc86b0bd71",
      "excerpt": [
        "[中州派]有[太阳天梁主别离]的说法。"
      ]
    },
    "wtz.deep.p062.b002": {
      "page": 62,
      "section": "太陽天梁坐卯酉",
      "sha256": "929c1a670d4349b264a5d224dfba5709cfbf741aa7891aea8bb5230415b32a05",
      "excerpt": [
        "以离乡背井为例，祥和者可能因为到外国求学，孤忌者则可能是逼于环境。二者的吉凶截然不同。"
      ]
    },
    "wtz.deep.p063.b013": {
      "page": 63,
      "section": "七殺獨坐辰戌",
      "sha256": "31067c5d6a9875ccc49a483d4e95b45271aa04302be928f64fe7a19d8ee0dc44",
      "excerpt": [
        "理想或幻想"
      ]
    },
    "wtz.deep.p065.b012": {
      "page": 65,
      "section": "七殺獨坐辰戌",
      "sha256": "ce69a80c20647fa516551481772a2b2aaf8010ee736ff11079bfa4a29e48b94a",
      "excerpt": [
        "[紫微斗数]视七杀为变化的扭钮",
        "忽视了它消极的一面。"
      ]
    },
    "wtz.deep.p066.b001": {
      "page": 66,
      "section": "七殺獨坐辰戌",
      "sha256": "5fa4e923915acbc40eb57187ff9816eccb0e2ed2c813b930e622289ec6959aae",
      "excerpt": [
        "注意到它理想与空想的本质，即应同时注意到它消极的一面。"
      ]
    },
    "wtz.deep.p067.b001": {
      "page": 67,
      "section": "天機獨坐巳亥",
      "sha256": "9dd844de414238f6fdda5630fcf46d0e7e3442e4b11d178cca8f08ee13a2da0e",
      "excerpt": [
        "机谋而且有计划的性质，便比机变要踏实得多。"
      ]
    },
    "wtz.deep.p067.b003": {
      "page": 67,
      "section": "天機獨坐巳亥",
      "sha256": "d650afa5abd2be466605801633fff9cb5fd9a172bd6a4b59c253e03c30758d77",
      "excerpt": [
        "若[天同巨门]一组星曜，带感情色彩，若明朗者，则影响天机的本质亦明朗。反之若阴暗者，则影响天机的本质亦阴暗。"
      ]
    },
    "wtz.deep.p070.b007": {
      "page": 70,
      "section": "紫微破軍坐丑未",
      "sha256": "bdc849c8c3800b90f1526dcfbf6396ac72641cdbe9e16dfdc3acc96150c78ab8",
      "excerpt": [
        "紫微破军二曜同度，本身已具有很强的叛逆性"
      ]
    },
    "wtz.deep.p070.b008": {
      "page": 70,
      "section": "紫微破軍坐丑未",
      "sha256": "55656659db8f702a98bf3ed7747845da26c007e86138fcb4f9eb4b4bc5cd3cb5",
      "excerpt": [
        "叛逆性其实亦是开创力，因为必先去旧然后开始更新"
      ]
    },
    "wtz.deep.p073.b004": {
      "page": 73,
      "section": "天府獨坐卯酉",
      "sha256": "65df1d75a29a520d922031ec6eb5afa4d88375a89d21cc8ffdabb848bd6390d3",
      "excerpt": [
        "十二宫的天府，以独坐卯酉二宫时最为安定、保守。"
      ]
    },
    "wtz.deep.p073.b005": {
      "page": 73,
      "section": "天府獨坐卯酉",
      "sha256": "e67df24cc653409bd2f29f22ab0ef9ba688f0a9e8f9e8fc6245e22346ad106b9",
      "excerpt": [
        "属于局面广大的老成持重，抑或只是细眉细眼的小心谨慎。"
      ]
    },
    "wtz.deep.p076.b006": {
      "page": 76,
      "section": "太陰獨坐辰戌",
      "sha256": "d89d02f132f7c97b5fc9265582c9bba13a524275cd7f4a0491f7e865e510fb98",
      "excerpt": [
        "有目的者，一举即可破罗网而出，有如游鱼脱网；但盲动者则愈挣扎愈受缠缚。"
      ]
    },
    "wtz.deep.p076.b007": {
      "page": 76,
      "section": "太陰獨坐辰戌",
      "sha256": "0f238b889dd3960a7acd6c8c6ce17366ea2ccceb6646828a01a7c0e184edeb3c",
      "excerpt": [
        "其盲动与否，亦与福德宫所躔的巨门有关。学者不妨加以研究。"
      ]
    },
    "wtz.deep.p078.b010": {
      "page": 78,
      "section": "廉貞貪狼坐巳亥",
      "sha256": "b45189b1d7b00f7d82da0515f03bc8e140d6278a4b7ebfde022322a70fa44336",
      "excerpt": [
        "要推断[廉贞贪狼]二曜同度的特质，须注意感情与物欲的区别。"
      ]
    },
    "wtz.deep.p079.b005": {
      "page": 79,
      "section": "廉貞貪狼坐巳亥",
      "sha256": "093fdb89244b8083152eadad88229ef5fcec4a9faf20f1bee7de71ead8e52186",
      "excerpt": [
        "这时候，宜福德宫坚强有力，则可有主张，不致随波逐流。"
      ]
    },
    "wtz.deep.p080.b005": {
      "page": 80,
      "section": "廉貞貪狼坐巳亥",
      "sha256": "0d32a53aaa7aa0adef9775470f505a464883ceb19571e57c7d9cc0a1ccf6d5c9",
      "excerpt": [
        "仅宜感情与物欲平衡的星系，彼此克制，则不致挫败。"
      ]
    },
    "wtz.deep.p082.b002": {
      "page": 82,
      "section": "巨門獨坐子午",
      "sha256": "087c3dc7d71dce8950a59b86db22f54c94cef1c1174fbaa843fb137357e1bc2f",
      "excerpt": [
        "亦只需注意它是英华内敛，或是内心疑忌。二者都属于内心世界，而且只有一线之差。"
      ]
    },
    "wtz.deep.p082.b003": {
      "page": 82,
      "section": "巨門獨坐子午",
      "sha256": "7c57af19333445aae8457e6786e8b4fcd57927ba00df6b08529b3f42520b3704",
      "excerpt": [
        "成[石中隐玉]格局的巨门，则将此种本质转化为收敛自己的才华。"
      ]
    },
    "wtz.deep.p084.b013": {
      "page": 84,
      "section": "天相獨坐丑未",
      "sha256": "0618b1d5a71438cd7ce4bdeec52509dc45846b01506c828c5474e85655b8a02d",
      "excerpt": [
        "要推断天相在这两个宫垣的性质，必须注意其气质之优雅或庸俗。"
      ]
    },
    "wtz.deep.p085.b001": {
      "page": 85,
      "section": "天相獨坐丑未",
      "sha256": "2e4f3eb3e60fb03704c209ca9130f2db8941e10eb9a028e4973c02ec8dcdd665",
      "excerpt": [
        "若优雅则尚不失其独立性"
      ]
    },
    "wtz.deep.p087.b011": {
      "page": 87,
      "section": "天同天梁坐寅申",
      "sha256": "1c615ee9866d1a87da0f308edc8d9878ec9491e1035ca949ba0e86da28658607",
      "excerpt": [
        "要推断此二宫度的[同梁]本质，必须认识其为带浪漫色彩，抑或带原则纪律。"
      ]
    },
    "wtz.deep.p346.b006": {
      "page": 346,
      "section": "天同",
      "sha256": "3f7bc5465f96eb0405dcc63f4b9cd9173b94ce9735aebd02ceeb0d3e8960e688",
      "excerpt": [
        "唯天同主情绪，梁主原则，二曜同宫，仍难免有矛盾冲突。"
      ]
    },
    "wtz.deep.p089.b009": {
      "page": 89,
      "section": "武曲七殺坐卯酉",
      "sha256": "428147ad956a7aafaae51f3493847ec6c24509cdc7543b0d5467f0aa33d6fb41",
      "excerpt": [
        "决断与短虑其实只一线之差",
        "所以这分别从外表很难看得出。"
      ]
    },
    "wtz.deep.p089.b010": {
      "page": 89,
      "section": "武曲七殺坐卯酉",
      "sha256": "a134502a786c04051bed78cca823218c551a5e862e3db3245cf548d0d051454a",
      "excerpt": [
        "凡[武曲七杀]属决断者，多留有余地，而短虑者则多薄情"
      ]
    },
    "wtz.deep.p092.b002": {
      "page": 92,
      "section": "太陽獨坐辰戌",
      "sha256": "9a0e5e5aafa52e2defe4428eaf79e296276632db72cd523728091000bc8e20cc",
      "excerpt": [
        "要推断此宫太阳的特性，须注意其有无受拖累剥削。"
      ]
    },
    "wtz.deep.p092.b007": {
      "page": 92,
      "section": "太陽獨坐辰戌",
      "sha256": "324d452295df16abda624230713f81e257f0b58fb6c54ac1467882c99407bc28",
      "excerpt": [
        "若太阳不受拖累剥削，则人生际遇自然顺遂"
      ]
    },
    "wtz.deep.p094.b009": {
      "page": 94,
      "section": "天機獨坐子午",
      "sha256": "b1af353aecdcbb2438224f79fab17a9b1b913f28ec3fac6de4304cc7e49e33b8",
      "excerpt": [
        "推断子午宫垣的天机本质，须分别其刚柔。"
      ]
    },
    "wtz.deep.p097.b004": {
      "page": 97,
      "section": "紫微天府坐寅申",
      "sha256": "44f5eff95f3ac4c13f646759ce971f4218326a33ab15bad1949faadd9c1b5211",
      "excerpt": [
        "要推断[紫微天府]这组星曜的物性，须注意其为主动，抑或被动。"
      ]
    },
    "wtz.deep.p097.b005": {
      "page": 97,
      "section": "紫微天府坐寅申",
      "sha256": "be32228467a82b9adcd0cf7248f72e7126709e48716c7868f8e452aaeb0b3812",
      "excerpt": [
        "紫微擅开创．天府擅守成，二曜同系，若性质平衡则自然可攻可守"
      ]
    },
    "wtz.deep.p100.b010": {
      "page": 100,
      "section": "太陰獨坐卯酉",
      "sha256": "16cae2a1b119a1451d8fcd80671950d695a953b2f20136f51692cf7ad07b7cb1",
      "excerpt": [
        "要推断此二宫垣的太阴特性，须注意其意志为坚强，抑为薄弱。"
      ]
    },
    "wtz.deep.p103.b004": {
      "page": 103,
      "section": "貪狼獨坐辰戌",
      "sha256": "963fbd2e86bd05f4eb90e6c87eb76904c55a56ecd0774ccfd0d2b0884159a294",
      "excerpt": [
        "推断其本质，须注意其为坚忍，抑为躁进。"
      ]
    },
    "wtz.deep.p103.b005": {
      "page": 103,
      "section": "貪狼獨坐辰戌",
      "sha256": "6c49de82ab8ba83b104d913179359647dae24d0376fb5d46c3c554d7d3ecde4f",
      "excerpt": [
        "唯于机遇未来之时，躁进则必多倾败，以致影响突发的基础。"
      ]
    },
    "wtz.deep.p106.b002": {
      "page": 106,
      "section": "巨門獨坐巳亥",
      "sha256": "97a98a75b985b0d84c63ba74b058c2d004503c2b95fc046fa2a12a9653809100",
      "excerpt": [
        "巨门坐守命宫的人，外表与内心常不如一，所以难以表面观察。"
      ]
    },
    "wtz.deep.p105.b010": {
      "page": 105,
      "section": "巨門獨坐巳亥",
      "sha256": "9fa6729817de0f530b752b7fbb226ca95717486a46c26233469608d1977205fd",
      "excerpt": [
        "深沉者虽偏向于理智仍有感情色彩，冲动者偏向于感情，仍有理智色彩"
      ]
    },
    "wtz.deep.p106.b003": {
      "page": 106,
      "section": "巨門獨坐巳亥",
      "sha256": "632630f08c30d2a954c2f41a7c3e885071da75450a63b0d861a0b236d94e6596",
      "excerpt": [
        "巨门喜入庙的太阳，不喜落陷。落陷则多是非口舌，更化为忌，则多拖累尤怨。"
      ]
    },
    "wtz.deep.p356.b010": {
      "page": 356,
      "section": "巨門",
      "sha256": "6d6c489bcdc4391d3295ea1946a804f99508f58c4f684521057b6e8df57f0fdb",
      "excerpt": [
        "巳宫巨门对宫太阳无力，故不为吉，仅见禄者始主勤俭致富"
      ]
    },
    "wtz.deep.p106.b010": {
      "page": 106,
      "section": "巨門獨坐巳亥",
      "sha256": "ee621e122c2e49c2ba75f8248b77c7549fc14c59a41bebb8ed5731090780f43a",
      "excerpt": [
        "杀、破、狼的大运或流年，为巨门坐命者重大转变的关键，必须祥其星曜会合情形，与巨门具的性质，合并研究"
      ]
    },
    "wtz.deep.p108.b007": {
      "page": 108,
      "section": "廉貞天相坐子午",
      "sha256": "e4fbecb489b5d3fdae375f5b2f4016aeb2efe9f09ba17a45cc6e61a8f06dc2af",
      "excerpt": [
        "要推断『廉相』一系在本宫的本质"
      ]
    },
    "wtz.deep.p108.b008": {
      "page": 108,
      "section": "廉貞天相坐子午",
      "sha256": "87fa6316aa73c5aea9876431947ab1be5d349cac35c88a464b02af1bd440792c",
      "excerpt": [
        "内心感情与外间环境的冲突，必须具刚毅之性，然后始能适应"
      ]
    },
    "wtz.deep.p347.b015": {
      "page": 347,
      "section": "廉貞",
      "sha256": "292fc923b89422652562a8cbd93bfb9141d2f3a43ea6c42d626262ae420ae681",
      "excerpt": [
        "子午宫[廉贞天相]同度，其气较和，与卯酉宫的[廉贞破军]其气躁决不同。"
      ]
    },
    "wtz.deep.p110.b014": {
      "page": 110,
      "section": "天梁獨坐丑未",
      "sha256": "1239d1e017788c556fd090b8df3596301a0b2e798c8dbdde5c22894f535b556d",
      "excerpt": [
        "须注意分别其为正值，抑为精明。"
      ]
    },
    "wtz.deep.p110.b015": {
      "page": 110,
      "section": "天梁獨坐丑未",
      "sha256": "8bb1959d81bf6fe4a0a3c8f7c706df859d52df4cc80d0d76dba81cc8d6c73ce9",
      "excerpt": [
        "精明则只是善于观察别人的缺点。对自己则有不同的尺度。"
      ]
    },
    "wtz.deep.p359.b005": {
      "page": 359,
      "section": "天梁",
      "sha256": "8b8fd57ff248f4999072c4333fd8c45d8f4a168131bea92c3cb578f53b5e0d58",
      "excerpt": [
        "天梁偏重精神而不偏生物质"
      ]
    },
    "wtz.deep.p113.b009": {
      "page": 113,
      "section": "七殺獨坐寅申",
      "sha256": "2742b31a02a59acbc85eed3cfbb9369d7f3a056081b0283234f04846c9e3502b",
      "excerpt": [
        "要推断此二宫限的七杀本质，须分别其为孤高，抑为威权。"
      ]
    },
    "wtz.deep.p113.b010": {
      "page": 113,
      "section": "七殺獨坐寅申",
      "sha256": "6eda3ddbb82d16550f72947881e6e0c13a203cd2710455032062ca0a80a8b50e",
      "excerpt": [
        "孤高的七杀表面亦似威权",
        "并不令人心服"
      ]
    },
    "wtz.deep.p363.b003": {
      "page": 363,
      "section": "七殺",
      "sha256": "b3462b5f20994e537bed99d0a3e6d4ea3022e98b8da490fd0276c4cae3116e3c",
      "excerpt": [
        "须详视福德宫及夫妻宫，以确定其品性。此影响后运甚大。"
      ]
    },
    "wtz.deep.p116.b004": {
      "page": 116,
      "section": "天同獨坐卯酉",
      "sha256": "18f8f93b5e6aec638db9f1b679c194d6e6c63a7c927cab883b1d097b47a38cfe",
      "excerpt": [
        "天同独坐此宫",
        "精神空虚，抑为充实。"
      ]
    },
    "wtz.deep.p116.b005": {
      "page": 116,
      "section": "天同獨坐卯酉",
      "sha256": "82208727073b2cc2ea56502f0885602fb3a1660a716251231495dcf76c0e8334",
      "excerpt": [
        "能白手成家的天同，必定精神充实。"
      ]
    },
    "wtz.deep.p119.b009": {
      "page": 119,
      "section": "武曲獨坐辰戌",
      "sha256": "c7cb0a6d74dd0de5ea62b8c033b7d62a7467b354c859d6f8b551b3cfa66f7c63",
      "excerpt": [
        "要推断此宫度的武曲本质，系分别其为因循抑或进取。"
      ]
    },
    "wtz.deep.p119.b010": {
      "page": 119,
      "section": "武曲獨坐辰戌",
      "sha256": "b065b035894c3cf3c4ad14b90c9c27154bf4dbeddc5bd95cb4c1f910a9c4954a",
      "excerpt": [
        "武曲落天罗地网，所以刚克之性受到压抑。然而其人生奋斗之心如何，可谓影响其命运甚大。"
      ]
    },
    "wtz.deep.p123.b004": {
      "page": 123,
      "section": "太陽獨坐巳亥",
      "sha256": "12745f2655c77b460eb9bf4267395883b51883f025b556dabedc3824ef2377a2",
      "excerpt": [
        "除注意其庙、陷之外，尚应注意因星曜会合而生的改变。"
      ]
    },
    "wtz.deep.p123.b008": {
      "page": 123,
      "section": "太陽獨坐巳亥",
      "sha256": "be34502c524fae256b18ffbc7c06a11a2768ec59e49c9e2464be6f11ba0f6110",
      "excerpt": [
        "凡本质积极的太阳，不但利进取，抵抗横逆的能力亦强"
      ]
    },
    "wtz.deep.p126.b004": {
      "page": 126,
      "section": "破軍獨坐子午",
      "sha256": "e08929475d9f6119e31e074303dd8b77a757c31a3139fac84e29bf14c740477d",
      "excerpt": [
        "有顽嚣与果敢的分别。"
      ]
    },
    "wtz.deep.p126.b005": {
      "page": 126,
      "section": "破軍獨坐子午",
      "sha256": "7a34f2da2d9b9c1269911859b4cf30dcc36194a28f4772030b8d69f90fc41dd1",
      "excerpt": [
        "果敢者则不同，并不主动求变，然而因应客观形势非变不可之时，却能果敢行动，而且其变动又有人生的目标。"
      ]
    },
    "wtz.deep.p364.b006": {
      "page": 364,
      "section": "破軍",
      "sha256": "1aec98a262b2a0a4e28856fbd1b8537ca7ee53d6866b347874fcce1007c901a5",
      "excerpt": [
        "破军有[继旧换新]的特性。所以每多兼行兼业兼职兼差。"
      ]
    },
    "wtz.deep.p364.b011": {
      "page": 364,
      "section": "破軍",
      "sha256": "9181c64c15e104022957624c5f10cf92d22334ac0771904164b5342a560a4cce",
      "excerpt": [
        "破军守命，主白手创兴事业。唯与天同之破尽祖业而后自行兴创不同。"
      ]
    },
    "wtz.deep.p365.b001": {
      "page": 365,
      "section": "破軍",
      "sha256": "ed808a617fa7bfb0fb6745f0537589d8e62adbde466ee8ff36c94d90d9490d35",
      "excerpt": [
        "藉父祖荫庇余力，自行开创改革以兴家。"
      ]
    },
    "wtz.deep.p365.b006": {
      "page": 365,
      "section": "破軍",
      "sha256": "f36b99a24b62cd0367c221cdb6797dcd340d87ea45bd0ad336e618d3979b0ec0",
      "excerpt": [
        "子午破军而不成[英星入庙格]者，六亲无缘，凡事须亲力亲为"
      ]
    },
    "wtz.deep.p364.b007": {
      "page": 364,
      "section": "破軍",
      "sha256": "cad8f11be47c3a5c87729f138ba05a29c7357b502794af2bee431b1c4e79c5a1",
      "excerpt": [
        "破军之破坏力，主要表现为[宁为玉碎，不为瓦全]，所以带有耗散的本质。"
      ]
    },
    "wtz.deep.p129.b009": {
      "page": 129,
      "section": "天機獨坐丑未",
      "sha256": "6b9fbbf56575ccdce38184c58c9398e7bfaaf53e82ff3ed498118b87eb239019",
      "excerpt": [
        "天机于丑未宫本为弱垣",
        "天机本宫不利，须仗其它星曜扶持。"
      ]
    },
    "wtz.deep.p133.b003": {
      "page": 133,
      "section": "紫微貪狼坐卯酉",
      "sha256": "c914736918d7550395bd9de28e839d017229822a4ecca4fd80949cce0f273d6c",
      "excerpt": [
        "[紫微贪狼]这系星曜，属于纯欲望型。"
      ]
    },
    "wtz.deep.p133.b006": {
      "page": 133,
      "section": "紫微貪狼坐卯酉",
      "sha256": "55eba099ca1b85c13cbed571de4c387430208aa199bd2853485bc154125876c2",
      "excerpt": [
        "但[紫贪]却带粉饰的意味，有领导欲，但却依旧有八面玲珑的手段。"
      ]
    },
    "wtz.deep.p133.b008": {
      "page": 133,
      "section": "紫微貪狼坐卯酉",
      "sha256": "66c6debed541743f64853be4983008e40075fc047b2100940d16fa13be46caa5",
      "excerpt": [
        "紫微独坐与贪狼相对，与[紫微贪狼]同度的最大不同，就是前者的领导力与决断力较大，后者则主动性较强"
      ]
    },
    "wtz.deep.p136.b003": {
      "page": 136,
      "section": "巨門獨坐辰戌",
      "sha256": "ef8e96f43be241db24f0e8932e5bca1daae7d39d2d18953bba64f69fcd33a902",
      "excerpt": [
        "巨门躔度于此两个宫度，为天罗地网"
      ]
    },
    "wtz.deep.p136.b008": {
      "page": 136,
      "section": "巨門獨坐辰戌",
      "sha256": "7aea6b94e77f3bac6fba7b96478ee745269e52725762f4cd18b9f10c6995fed8",
      "excerpt": [
        "巨门在辰戌宜见温和的刺激"
      ]
    },
    "wtz.deep.p138.b009": {
      "page": 138,
      "section": "天相獨坐巳亥",
      "sha256": "a9fea901459b6b76b379d06446680d0675ef38c9bf8af7be8c0daa1fd50e0844",
      "excerpt": [
        "既具坚忍不拔的个性，又富开创力。只需不为[刑忌]所夹，一般均有优良性质。然由于天相本身缺乏独立性，所以很难独立作主。"
      ]
    },
    "wtz.deep.p141.b005": {
      "page": 141,
      "section": "天梁獨坐子午",
      "sha256": "d7a2a276c9781fb3fe5523b66d980a6d43d7a926c719db703ebb75cb0872be67",
      "excerpt": [
        "要分别此二宫垣的天梁本质，须注意其为孤克，抑为融合。"
      ]
    },
    "wtz.deep.p141.b010": {
      "page": 141,
      "section": "天梁獨坐子午",
      "sha256": "cdbd1c46db896a493f263bc0792d78cb0a010de312536d5c544fb89278efc3b5",
      "excerpt": [
        "具融和性质的天梁，始宜从政、从商，并以计划、监察、管理为宜"
      ]
    },
    "wtz.deep.p359.b003": {
      "page": 359,
      "section": "天梁",
      "sha256": "aa1fb133fb4167e73b456b7d61a0d6ced0722a8cf6064e8c98244e5c4630f641",
      "excerpt": [
        "留意这些荫庇之力，尽属精神而不属物质，由是即可知道天梁的特性。"
      ]
    },
    "wtz.deep.p144.b003": {
      "page": 144,
      "section": "廉貞七殺坐丑未",
      "sha256": "42f4c890a3d9d9945babf230a958805f059424c61ac904d5640ebe0d5c61cf6d",
      "excerpt": [
        "要推断[廉杀]在此二宫垣的本质，须分别其为奋发，抑或刚戾。"
      ]
    },
    "wtz.deep.p144.b004": {
      "page": 144,
      "section": "廉貞七殺坐丑未",
      "sha256": "db7631551f50b2a06753f14991627940f6c973bfce33ae81350fc19159c097fe",
      "excerpt": [
        "即在未宫，见诸吉，特别是文昌、文曲，且同会禄存、化禄，而无四煞空劫会照，可以作为奋发的代表"
      ]
    },
    "wtz.deep.p144.b005": {
      "page": 144,
      "section": "廉貞七殺坐丑未",
      "sha256": "fc7b334d7f5b212cab9bb45ae116663e91b1a4c8c9b8a892d2a6f426f6215208",
      "excerpt": [
        "所谓刚戾，是指星曜的性质而不是指本人的气质",
        "须详十二宫星曜而定其性质。"
      ]
    },
    "wtz.deep.p144.b006": {
      "page": 144,
      "section": "廉貞七殺坐丑未",
      "sha256": "b80585a988b823ced8836d31536c55ce59d4f508005592aa8ca8867560c67b55",
      "excerpt": [
        "[廉杀]最喜见禄、化禄。有禄而吉凶星曜并见，亦主奋发。这是基本条件。"
      ]
    },
    "wtz.deep.p361.b011": {
      "page": 361,
      "section": "七殺",
      "sha256": "ab7a25cfdfa6cfdff52ef921e98bee319bf0592767e3c8c45f3fc526c1c7b2ab",
      "excerpt": [
        "必须脚踏实地，将此段时期捱过，然后始见吐气扬眉。"
      ]
    },
    "wtz.deep.p147.b005": {
      "page": 147,
      "section": "天同獨坐辰戌",
      "sha256": "b8fb3db198549db16d667e7c4f59bbb84fc4f797d9d9b0ff350dc5c8020ad5b6",
      "excerpt": [
        "要推断天同在此二宫垣的本质，须分别其为豁达，抑为短志。"
      ]
    },
    "wtz.deep.p147.b008": {
      "page": 147,
      "section": "天同獨坐辰戌",
      "sha256": "5bf9cf7cda09cd7758a2dbb936d07edcc85628b86aeee79c49ba6bdc13db8d17",
      "excerpt": [
        "豁达的天同，韧力很强"
      ]
    },
    "wtz.deep.p150.b005": {
      "page": 150,
      "section": "武曲破軍坐巳亥",
      "sha256": "2822229ae278c216d1ae7ddae78d8e10afbc0e26a90aab8b0439a93708034cf3",
      "excerpt": [
        "善于适应，抑或具反拗的本质"
      ]
    },
    "wtz.deep.p150.b006": {
      "page": 150,
      "section": "武曲破軍坐巳亥",
      "sha256": "1aaed4d2121c467a8f5d3b9ce2749efd5abe944885a87b33869621a302d58be6",
      "excerpt": [
        "具适应力的武曲，不但于客观环境顺逆时能开创， 即使环境不利， 亦能利用环境。"
      ]
    },
    "wtz.deep.p150.b010": {
      "page": 150,
      "section": "武曲破軍坐巳亥",
      "sha256": "7bfcb90d0efa19681076f8c533f9b05f5f80b10a7f2b7917325170ff301b34de",
      "excerpt": [
        "若无吉曜同度，又不见吉化，但见火铃、羊陀、空劫同会(尤忌空劫二星同度并人命宫)，则亦具反拗之性"
      ]
    },
    "wtz.deep.p153.b006": {
      "page": 153,
      "section": "太陽獨坐子午",
      "sha256": "9a0955f79a28b7cbfc609504e9afdfec343761b4108e458897ee192ba04f7132",
      "excerpt": [
        "要推断这两个宫垣的太阳本质，须分别其为虚浮，抑为沉稳。"
      ]
    },
    "wtz.deep.p153.b015": {
      "page": 153,
      "section": "太陽獨坐子午",
      "sha256": "84c4f973ebdc991a034857ffe3e4bf54897c1d717a0868aac78a017c97d5128c",
      "excerpt": [
        "而虚浮的太阳，则往往仅表面风光，内在则空虚"
      ]
    },
    "wtz.deep.p156.b006": {
      "page": 156,
      "section": "天府獨坐丑未",
      "sha256": "b3d5a686b2391debed628f76823b702be801fdb9fe7743926b6ce0213225b137",
      "excerpt": [
        "一般而言，未宫的天府较丑宫为佳，能于保守中寻求突破，丑宫者则多为纯保守型。"
      ]
    },
    "wtz.deep.p156.b008": {
      "page": 156,
      "section": "天府獨坐丑未",
      "sha256": "8fe3b3fecab1fb7c4d09bf484e8ff77cc3e9e52326d469e63e3843542dc785b2",
      "excerpt": [
        "但要推断天府在此二宫垣的本质，则须注意其为谦和，抑或怯懦。"
      ]
    },
    "wtz.deep.p156.b009": {
      "page": 156,
      "section": "天府獨坐丑未",
      "sha256": "fb9c9995b98c61a51edf7cf7759ee54d080837d02b7d02cab6d98cf36463977f",
      "excerpt": [
        "为人虽不露棱角，但外圆内方，做事依然有原则"
      ]
    },
    "wtz.deep.p156.b010": {
      "page": 156,
      "section": "天府獨坐丑未",
      "sha256": "2fc6873379bad7922c64c10e056dfc997e72a963bdb8f90ffdcab4984551157a",
      "excerpt": [
        "表面上为小心谨慎，实际上做事缺乏原则"
      ]
    },
    "wtz.deep.p350.b005": {
      "page": 350,
      "section": "天府",
      "sha256": "6e725206ff00aa15ecadbe5ebcb0990342b311e174d8d51c0e4b9b11ae1cc2e9",
      "excerpt": [
        "其开创力及权力是否能运用自如，需视七杀宫垣所会合的星曜而定。"
      ]
    },
    "wtz.deep.p159.b010": {
      "page": 159,
      "section": "天機太陰坐寅申",
      "sha256": "139a997a58580142347a634b37798a9d7f949bd902633bbd6345ddfd4e818652",
      "excerpt": [
        "理智抑或情绪。"
      ]
    },
    "wtz.deep.p159.b011": {
      "page": 159,
      "section": "天機太陰坐寅申",
      "sha256": "b7783f128a96aa4b24fc7e255fbda324cafcc6c1e011484164f011fc814ed4e0",
      "excerpt": [
        "天梁主理智，在午宫者尤甚，化权、化科又更甚。"
      ]
    },
    "wtz.deep.p159.b012": {
      "page": 159,
      "section": "天機太陰坐寅申",
      "sha256": "f0e7371e0541b18fe07e9b4793db22728708436ef57d33b856179bcd88bed205",
      "excerpt": [
        "天同主情绪，化禄、化忌皆加重感情色彩。"
      ]
    },
    "wtz.deep.p163.b004": {
      "page": 163,
      "section": "紫微天相坐辰戌",
      "sha256": "4758961c8fdadaa1a2f85f25521cde28dd8c69a5aae91da356ac2304a2be7321",
      "excerpt": [
        "主要的缺点是[紫相]守命的人太过急功近利"
      ]
    },
    "wtz.deep.p163.b005": {
      "page": 163,
      "section": "紫微天相坐辰戌",
      "sha256": "b6fe182b1b5743beca9b0466a3ad7590f1e7cb30a0f09a38be101a8e88122c56",
      "excerpt": [
        "所谓有情无情，当然只是就紫相本身比较而言。"
      ]
    },
    "wtz.deep.p164.b003": {
      "page": 164,
      "section": "紫微天相坐辰戌",
      "sha256": "21f8fdb26a2bbf68018091291b9fea4c0f0c14afd37743370eac79ef0e8cbda2",
      "excerpt": [
        "[紫相]的无情有时并非主动",
        "所以无情并非一定等于薄情。"
      ]
    },
    "wtz.deep.p166.b008": {
      "page": 166,
      "section": "天梁獨坐巳亥",
      "sha256": "75e4ffe91085f4ecec18c9ebe261626779903860ba21cf0d3f54662365e41d6a",
      "excerpt": [
        "所会的星曜皆多动荡"
      ]
    },
    "wtz.deep.p166.b009": {
      "page": 166,
      "section": "天梁獨坐巳亥",
      "sha256": "5ada9b73a99bcce6a80d4d10921eae1ceda59336ad8b1c55d58451b190458033",
      "excerpt": [
        "所谓[稳定]，当然乃相对而言，只是此二宫垣天梁本身的比较，并不代表比其它星系稳定"
      ]
    },
    "wtz.deep.p169.b011": {
      "page": 169,
      "section": "七殺獨坐子午",
      "sha256": "acfab9d6d73f726de539bbe6ad7c6c5703a1043dbe9d523b3ca97942ee45ee78",
      "excerpt": [
        "尤其是午宫的七杀，见吉即为[雄宿干元格]，主人少年经历艰辛而后兴发。"
      ]
    },
    "wtz.deep.p170.b002": {
      "page": 170,
      "section": "七殺獨坐子午",
      "sha256": "9836aef3332e4c09aca7834002e2b7822154a2a674d22e02484d1831c6c4108a",
      "excerpt": [
        "要判别此二宫垣的七杀本质，须分别其为权威，抑为克忌。"
      ]
    },
    "wtz.deep.p172.b010": {
      "page": 172,
      "section": "廉貞獨坐寅申",
      "sha256": "71baa2dacfc12c3f00c8071d9baf09df96078567d3c35498ebf9105ea63611e3",
      "excerpt": [
        "敏感，抑为踏实。"
      ]
    },
    "wtz.deep.p172.b011": {
      "page": 172,
      "section": "廉貞獨坐寅申",
      "sha256": "b904ff9786c02595f5a13d5c347b5cd66f7bef4b3aa5539cb690d6bcf56c4bc7",
      "excerpt": [
        "敏感的廉贞一般带艺术气质，重视精神生活。"
      ]
    },
    "wtz.deep.p172.b012": {
      "page": 172,
      "section": "廉貞獨坐寅申",
      "sha256": "ad1971a3ced972969f69411ac4aadd838641f1061f9942645944d7fae12496b2",
      "excerpt": [
        "廉贞化禄，贪狼化禄、化权，均具此种本质"
      ]
    },
    "wtz.deep.p175.b008": {
      "page": 175,
      "section": "破軍獨坐辰戌",
      "sha256": "ba7f1bf4c40ecffd8d1892700ca8988cda3650c860ad10beccf6620412e2e04f",
      "excerpt": [
        "仍可判别其本质偏枯，抑为调和。"
      ]
    },
    "wtz.deep.p176.b001": {
      "page": 176,
      "section": "破軍獨坐辰戌",
      "sha256": "2742642f8f183a0a058bf4ee9a2d08508635b9d976901376de60197144c1613f",
      "excerpt": [
        "所以在此二宫垣的破军，必须得禄始为佳，无其它解救之道。"
      ]
    },
    "wtz.deep.p178.b007": {
      "page": 178,
      "section": "天同獨坐巳亥",
      "sha256": "db3d816cda16317cd062d3e77b9e8f86ecc01be3be49c3e02d6f1bab5d864304",
      "excerpt": [
        "要推断在此二宫垣的天同本质，须详其为意志薄弱，抑为意志坚强。"
      ]
    },
    "wtz.deep.p345.b002": {
      "page": 345,
      "section": "天同",
      "sha256": "bef675546c59dc322858a374ac68a812090891376b0b41768500b1d11a5b6975",
      "excerpt": [
        "天同为纯粹精神型的星曜，喜受激发，然后始有奋发之心"
      ]
    },
    "wtz.deep.p344.b014": {
      "page": 344,
      "section": "天同",
      "sha256": "bc5f69d0380081e008d87f70cc417993b87e5ce31d50774dc278db17054971f9",
      "excerpt": [
        "天同主情绪，所以当辅佐诸曜会集之时，反而未必是吉，因为可以产生依赖性"
      ]
    },
    "wtz.deep.p345.b001": {
      "page": 345,
      "section": "天同",
      "sha256": "b39e624f1d6e31e70a5eb9da2decf5b2d93d036cd6387c516475b7dd4001181f",
      "excerpt": [
        "使人生容易因小成就即躯于安乐。"
      ]
    },
    "wtz.deep.p181.b009": {
      "page": 181,
      "section": "武曲天府坐子午",
      "sha256": "c484d8aea87284d83590f17d627652762fbaedd55ee8b2323947cf2c481792ba",
      "excerpt": [
        "武曲及天府均为财星，然而武曲主行动，天府则为府库",
        "二者性质不同。"
      ]
    },
    "wtz.deep.p181.b010": {
      "page": 181,
      "section": "武曲天府坐子午",
      "sha256": "789716e4ce0830b3f40682b4766df9e11c30ec3653c4dda0a0f4b351f9754f7a",
      "excerpt": [
        "须分别其为仅擅生财，抑或擅长理财(即包括生财及储存的能力)。"
      ]
    },
    "wtz.deep.p185.b005": {
      "page": 185,
      "section": "太陰太陽坐丑未",
      "sha256": "34fa2ca695540ad19b2135cd34e6f4211c419ad0b477426108f0a952a16c3584",
      "excerpt": [
        "坐此二宫垣的本质，便须分别其为开朗，抑为沈郁。"
      ]
    },
    "wtz.deep.p185.b006": {
      "page": 185,
      "section": "太陰太陽坐丑未",
      "sha256": "ccaca43fd7d58dd8a97266a3432e750fb828a29bf0235b6e4eb60a7981b5ff50",
      "excerpt": [
        "太阳的光热足以解天梁的孤忌，则此格局的『日月』便属于开朗",
        "若相反，太阳的光热不足以解天梁的孤忌，便属于沈郁。"
      ]
    },
    "wtz.deep.p188.b007": {
      "page": 188,
      "section": "貪狼獨坐寅申",
      "sha256": "af8dbd7d3ac8602ea6eb2af6af81ce4e2dae00ffb4dd356c9624ef56100e60ca",
      "excerpt": [
        "贪狼在寅申纯主欲望；但在寅宫者则倾向于色欲或情感，在申宫者则倾向于物欲或物质，这属于基本性质。"
      ]
    },
    "wtz.deep.p191.b004": {
      "page": 191,
      "section": "天機巨門坐卯酉",
      "sha256": "2dedfc6569975e026367e0df3f2faa706f01bf3e72d0ca8d5d384db4ed37cc4f",
      "excerpt": [
        "在此二宫垣的[机巨]，主要缺点为浮滑及多疑，必须得吉化、吉曜，然后始可减轻其缺点"
      ]
    },
    "wtz.deep.p191.b006": {
      "page": 191,
      "section": "天機巨門坐卯酉",
      "sha256": "4259bfbaf8063a509d45b9ca4cdeb62923eefb905312d9b0edc3fcdab0596074",
      "excerpt": [
        "二者之间的分别很大，所以需要详细研究。"
      ]
    },
    "wtz.deep.p194.b004": {
      "page": 194,
      "section": "紫微七殺坐巳亥",
      "sha256": "7df33ad45dfa33722d5a3badedc98604bfdbd1b04babb8cdf52caac4c12be147",
      "excerpt": [
        "这组星系属于纯物质性的结构"
      ]
    },
    "wtz.deep.p194.b005": {
      "page": 194,
      "section": "紫微七殺坐巳亥",
      "sha256": "f7d6709e97c7a628eb4823ace3351ad2b0acd90d6ac021f0bce86dbc9476867b",
      "excerpt": [
        "不过，[紫杀]在命的人通常无如此强烈的极端性质，所以只是两种性质中的倾向比较而已。"
      ]
    },
    "wtz.deep.p194.b006": {
      "page": 194,
      "section": "紫微七殺坐巳亥",
      "sha256": "e32a9cd4d90dba5822ffa199957bb1b85bd585d721bf112cfe41991ccb91028d",
      "excerpt": [
        "[紫微七杀]本身即有权力的性质，所以再不宜加强其权力，否则即易变成横霸。"
      ]
    },
    "wtz.deep.p198.b001": {
      "page": 198,
      "section": "廉貞破軍坐卯酉",
      "sha256": "95fec3ccf6e6e18c9a427a370e1b520520679967f5ec5c39505d932e121b82d1",
      "excerpt": [
        "[廉贞破军]于卯酉宫同度，对宫为天相"
      ]
    },
    "wtz.deep.p198.b002": {
      "page": 198,
      "section": "廉貞破軍坐卯酉",
      "sha256": "4563588e7299dfdc4ed938a1e9b9747f5995f3a41453568b246917e349b50583",
      "excerpt": [
        "以服务为性质，以开创为职责。"
      ]
    },
    "wtz.deep.p349.b004": {
      "page": 349,
      "section": "廉貞",
      "sha256": "161170b9df12c95dc7f1da372d092f649a701e6932b5aaf099897ba7435b9548",
      "excerpt": [
        "卯酉[廉破]具创造力，见擎羊同度，无刑耗，主人有巧思巧艺。"
      ]
    },
    "wtz.deep.p201.b001": {
      "page": 201,
      "section": "天府獨坐巳亥",
      "sha256": "f72716edda230df4ca577fb6bd766028e37cef2ac5a11c004977be9e4d03fba4",
      "excerpt": [
        "所会者多为权力以及欲望之星，因而独坐的天府保守性亦较小。"
      ]
    },
    "wtz.deep.p203.b009": {
      "page": 203,
      "section": "天同太陰坐子午",
      "sha256": "fa8b2ecc7dde394085010126e625a74c1d55ac013d35b8e5cf6fee122639667d",
      "excerpt": [
        "要推断此二宫垣的[天同太阴]本质，须分别其为积极，抑或消极"
      ]
    },
    "wtz.deep.p203.b010": {
      "page": 203,
      "section": "天同太陰坐子午",
      "sha256": "2ef541c9b88e84265b4447e233f4781ef18f9aaeae210bddf31efd5f3d7925be",
      "excerpt": [
        "在子则不喜擎羊同度，正因子宫的[同月]较为消极，经不起人生的磨练。"
      ]
    },
    "wtz.deep.p206.b006": {
      "page": 206,
      "section": "武曲貪狼坐丑未",
      "sha256": "6677bf4d3210cc8f95c3183d25cdc32d165fb75f8e4f66857e0787cba3a820b0",
      "excerpt": [
        "要推断此二宫垣的[武贪]的本质，须分别其为欲望，抑为野心。"
      ]
    },
    "wtz.deep.p206.b007": {
      "page": 206,
      "section": "武曲貪狼坐丑未",
      "sha256": "3c1bc11b9d5d3cc4276d72eb53e48f17d2d00d72a65a2132d2ba91b83cbeb732",
      "excerpt": [
        "欲望人人皆有，因为不伤害到别人，所以反成为人生鞭策的力量。"
      ]
    },
    "wtz.deep.p209.b011": {
      "page": 209,
      "section": "太陽巨門坐寅申",
      "sha256": "cc797c1283926f1760e8fcc53b2d4f8d63560b729e6650adbc5202a591bf756f",
      "excerpt": [
        "此二宫垣的[太阳巨门]，由于三方均无正曜",
        "古人界定其为异族(或外乡人)"
      ]
    },
    "wtz.deep.p209.b012": {
      "page": 209,
      "section": "太陽巨門坐寅申",
      "sha256": "513cbbb3542eb4959cf4389c60afbf1989ee7ffdc9cd8788a88f767f774b0c0f",
      "excerpt": [
        "所以要推断此二宫垣[太阳巨门]的本质，须分别其为得助，抑为孤立。"
      ]
    },
    "wtz.deep.p212.b009": {
      "page": 212,
      "section": "天相獨坐卯酉",
      "sha256": "b32771f35f649d2025b0045470e5b44abdfca487aaf8916914af438a0f407f93",
      "excerpt": [
        "其为正值，抑为徇私。"
      ]
    },
    "wtz.deep.p212.b010": {
      "page": 212,
      "section": "天相獨坐卯酉",
      "sha256": "ec1624a1afbeca3cca0af3330245d527303cb356dfcaea30e23041bd837c76e5",
      "excerpt": [
        "徇私与私利不同，私利者只谋求个人的利益，而徇私者则是无原则地照顾友情。"
      ]
    },
    "wtz.deep.p215.b012": {
      "page": 215,
      "section": "天機天梁坐辰戌",
      "sha256": "342ad1e8aa003a4539e50833135d56afc09334ae09d022dd0ccbf4cb3f2f96ea",
      "excerpt": [
        "天机主敏感变动，天梁则主原则纪律，若二者性格调和，则为明断的本质。"
      ]
    },
    "wtz.deep.p215.b013": {
      "page": 215,
      "section": "天機天梁坐辰戌",
      "sha256": "7d35f97fa889b3bbe1ab568431c2ccb17cb44fe24a3f74c4a980f6c0ad047947",
      "excerpt": [
        "以三合宫的星曜而言，[天同太阴]性质偏向于敏感，[太阳巨门]的性质则偏向于原则"
      ]
    }
  },
