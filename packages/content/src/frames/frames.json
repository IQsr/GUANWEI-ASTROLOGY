[
  { "id": "frame.open.命宮", "kind": "open", "palace": "命宮", "status": "reviewed",
    "text": "這一章讀命宮，也就是你出發時的位置。它描述的是傾向與起點，不是你這個人的全部。" },
  { "id": "frame.open.兄弟", "kind": "open", "palace": "兄弟", "status": "reviewed",
    "text": "這一章讀兄弟宮。它看的是你與平輩之間的相處結構，不評斷誰對誰錯，也不代手足本人發言。" },
  { "id": "frame.open.夫妻", "kind": "open", "palace": "夫妻", "status": "reviewed",
    "text": "這一章讀夫妻宮。它談的是你在親密關係裡的相處方式，不預測婚姻成敗，也不代伴侶發言。" },
  { "id": "frame.open.子女", "kind": "open", "palace": "子女", "status": "reviewed",
    "text": "這一章讀子女宮。它看的是你對下一代、對創造的態度，不推斷你會不會有孩子、有幾個。" },
  { "id": "frame.open.財帛", "kind": "open", "palace": "財帛", "status": "reviewed",
    "text": "這一章讀財帛宮。它講你與金錢的關係和賺取方式，不談金額，也不會變成一句理財建議。" },
  { "id": "frame.open.疾厄", "kind": "open", "palace": "疾厄", "status": "reviewed",
    "text": "這一章讀疾厄宮。它只談體質傾向與壓力模式，不涉病名、不涉診斷，也不作任何風險分級。" },
  { "id": "frame.open.遷移", "kind": "open", "palace": "遷移", "status": "reviewed",
    "text": "這一章讀遷移宮。它看的是你在陌生環境裡的樣子，與命宮正對，兩章要放在一起讀。" },
  { "id": "frame.open.僕役", "kind": "open", "palace": "僕役", "status": "reviewed",
    "text": "這一章讀交友宮，古稱奴僕宮。它看的是你在人群與合作裡的位置，不指認任何人。" },
  { "id": "frame.open.官祿", "kind": "open", "palace": "官祿", "status": "reviewed",
    "text": "這一章讀官祿宮。它談你做事的方式與成果的來路，不預測職位升降，也不替你決定去留。" },
  { "id": "frame.open.田宅", "kind": "open", "palace": "田宅", "status": "reviewed",
    "text": "這一章讀田宅宮。它談你與住的地方、與家的關係，不等同於買不買樓這一件事。" },
  { "id": "frame.open.福德", "kind": "open", "palace": "福德", "status": "reviewed",
    "text": "這一章讀福德宮。它看的是你內在安放自己的方式，只作反思題目，不作任何臨床判斷。" },
  { "id": "frame.open.父母", "kind": "open", "palace": "父母", "status": "reviewed",
    "text": "這一章讀父母宮。它談你與權威、與長輩的相處結構，不由你的盤推論家人的處境。" },

  { "id": "frame.transition.開場-結構.1", "kind": "transition", "from": "開場", "to": "結構", "status": "reviewed",
    "text": "先看這一宮本身的結構。" },
  { "id": "frame.transition.開場-結構.2", "kind": "transition", "from": "開場", "to": "結構", "status": "reviewed",
    "text": "由這裡開始，逐層看下去。" },
  { "id": "frame.transition.開場-結構.3", "kind": "transition", "from": "開場", "to": "結構", "status": "reviewed",
    "text": "這一宮的底細，可以再看細一點。" },
  { "id": "frame.transition.結構-牽動.1", "kind": "transition", "from": "結構", "to": "牽動", "status": "reviewed",
    "text": "這一宮不是獨立看的。" },
  { "id": "frame.transition.結構-牽動.2", "kind": "transition", "from": "結構", "to": "牽動", "status": "reviewed",
    "text": "接著要看它牽動到哪裡。" },
  { "id": "frame.transition.結構-牽動.3", "kind": "transition", "from": "結構", "to": "牽動", "status": "reviewed",
    "text": "把鄰近的幾宮一起放進來看。" },
  { "id": "frame.transition.牽動-擾動.1", "kind": "transition", "from": "牽動", "to": "擾動", "status": "reviewed",
    "text": "這個結構裡另有一些條件。" },
  { "id": "frame.transition.牽動-擾動.2", "kind": "transition", "from": "牽動", "to": "擾動", "status": "reviewed",
    "text": "還有幾點值得放在旁邊看。" },
  { "id": "frame.transition.擾動-留白.1", "kind": "transition", "from": "擾動", "to": "留白", "status": "reviewed",
    "text": "這一章到這裡為止。" },
  { "id": "frame.transition.擾動-留白.2", "kind": "transition", "from": "擾動", "to": "留白", "status": "reviewed",
    "text": "說到這裡，剩下的交回給你。" },
  { "id": "frame.transition.牽動-留白.1", "kind": "transition", "from": "牽動", "to": "留白", "status": "reviewed",
    "text": "以上是盤面說得出的部分。" },
  { "id": "frame.transition.牽動-留白.2", "kind": "transition", "from": "牽動", "to": "留白", "status": "reviewed",
    "text": "結構講完了，接下來是你自己的部分。" },

  { "id": "frame.close.命宮.1", "kind": "close", "palace": "命宮", "status": "reviewed",
    "text": "值得自己驗證的是：別人形容你的樣子，與你獨處時的樣子，相差有多遠。" },
  { "id": "frame.close.命宮.2", "kind": "close", "palace": "命宮", "status": "reviewed",
    "text": "可以留給自己想一想：你最像自己的時候，通常是在做什麼事情。" },
  { "id": "frame.close.命宮.3", "kind": "close", "palace": "命宮", "status": "reviewed",
    "text": "這一章說的是起點，不是終點。你走到今天，有多少是順著它，有多少是繞開它。" },
  { "id": "frame.close.命宮.4", "kind": "close", "palace": "命宮", "status": "reviewed",
    "text": "留一個問題給你自己：你眼中的你，和這一宮描述的性情，重疊在哪裡。" },

  { "id": "frame.close.兄弟.1", "kind": "close", "palace": "兄弟", "status": "reviewed",
    "text": "值得自己看看：與平輩相處的時候，你比較習慣站前面，還是站旁邊。" },
  { "id": "frame.close.兄弟.2", "kind": "close", "palace": "兄弟", "status": "reviewed",
    "text": "可以留意的是：你和手足之間，說得出口的和說不出口的，各佔多少。" },
  { "id": "frame.close.兄弟.3", "kind": "close", "palace": "兄弟", "status": "reviewed",
    "text": "這一宮講的是同輩之間的位置。你最近一次與人並肩做一件事，感覺如何。" },
  { "id": "frame.close.兄弟.4", "kind": "close", "palace": "兄弟", "status": "reviewed",
    "text": "留給你自己驗證：在同輩裡面，你是先開口那一個，還是等別人開口那一個。" },

  { "id": "frame.close.夫妻.1", "kind": "close", "palace": "夫妻", "status": "reviewed",
    "text": "值得自己想的是：在親密關係裡，你靠近一個人的方式，是不是和你形容的一樣。" },
  { "id": "frame.close.夫妻.2", "kind": "close", "palace": "夫妻", "status": "reviewed",
    "text": "可以留意的是：你希望被怎樣對待，和你實際上怎樣對待伴侶，差距在哪裡。" },
  { "id": "frame.close.夫妻.3", "kind": "close", "palace": "夫妻", "status": "reviewed",
    "text": "這一宮講的是相處的方式，不是結局。你們之間的節奏，多數是誰在定。" },
  { "id": "frame.close.夫妻.4", "kind": "close", "palace": "夫妻", "status": "reviewed",
    "text": "留一個問題給你自己：兩個人之間，你比較怕爭吵，還是比較怕安靜。" },

  { "id": "frame.close.子女.1", "kind": "close", "palace": "子女", "status": "reviewed",
    "text": "值得自己看看：你對下一代的期望，有多少其實是對自己的期望。" },
  { "id": "frame.close.子女.2", "kind": "close", "palace": "子女", "status": "reviewed",
    "text": "可以留意的是：你在培育一件事或者一個人的時候，放手通常放在哪一步。" },
  { "id": "frame.close.子女.3", "kind": "close", "palace": "子女", "status": "reviewed",
    "text": "這一宮也講創造。你手上有沒有一件東西，是你願意慢慢養大的。" },
  { "id": "frame.close.子女.4", "kind": "close", "palace": "子女", "status": "reviewed",
    "text": "留給你自己驗證：面對晚輩，你比較常給意見，還是比較常給空間。" },

  { "id": "frame.close.財帛.1", "kind": "close", "palace": "財帛", "status": "reviewed",
    "text": "值得自己驗證的是：你手上的錢，有多少是等回來的，有多少是做回來的。" },
  { "id": "frame.close.財帛.2", "kind": "close", "palace": "財帛", "status": "reviewed",
    "text": "可以留意的是：你花錢最爽快的那一刻，買的通常是東西，還是安心。" },
  { "id": "frame.close.財帛.3", "kind": "close", "palace": "財帛", "status": "reviewed",
    "text": "這一宮講的是你與資源的關係。錢對你來說，比較像工具，還是像分數。" },
  { "id": "frame.close.財帛.4", "kind": "close", "palace": "財帛", "status": "reviewed",
    "text": "留一個問題給你自己：如果收入少一截，你最先放手的會是什麼。" },

  { "id": "frame.close.疾厄.1", "kind": "close", "palace": "疾厄", "status": "reviewed",
    "text": "值得自己留意的是：你通常在什麼情況下最容易累，而那件事可不可以少做一點。" },
  { "id": "frame.close.疾厄.2", "kind": "close", "palace": "疾厄", "status": "reviewed",
    "text": "可以想一想：你說還撐得住的時候，多數是真的撐得住，還是不想麻煩別人。" },
  { "id": "frame.close.疾厄.3", "kind": "close", "palace": "疾厄", "status": "reviewed",
    "text": "這一宮講的是負荷的形狀。你休息的方式，有沒有真的讓你回過氣來。" },
  { "id": "frame.close.疾厄.4", "kind": "close", "palace": "疾厄", "status": "reviewed",
    "text": "留給你自己：身體最近一次提醒你的時候，你是聽了，還是繞過去了。" },

  { "id": "frame.close.遷移.1", "kind": "close", "palace": "遷移", "status": "reviewed",
    "text": "值得自己驗證的是：在陌生的地方，你是變得比較放鬆，還是比較緊。" },
  { "id": "frame.close.遷移.2", "kind": "close", "palace": "遷移", "status": "reviewed",
    "text": "可以留意的是：你出門在外時候的樣子，家裡人認不認得出來。" },
  { "id": "frame.close.遷移.3", "kind": "close", "palace": "遷移", "status": "reviewed",
    "text": "這一宮與命宮永遠正對。你在外面的那一面，和在家的那一面，哪一面比較久。" },
  { "id": "frame.close.遷移.4", "kind": "close", "palace": "遷移", "status": "reviewed",
    "text": "留一個問題給你自己：你上一次主動離開熟悉的地方，是為了什麼。" },

  { "id": "frame.close.僕役.1", "kind": "close", "palace": "僕役", "status": "reviewed",
    "text": "值得自己看看：你的朋友裡面，是同一種人比較多，還是差很遠的人比較多。" },
  { "id": "frame.close.僕役.2", "kind": "close", "palace": "僕役", "status": "reviewed",
    "text": "可以留意的是：合作的時候你最在意的，是把事做完，還是把人留住。" },
  { "id": "frame.close.僕役.3", "kind": "close", "palace": "僕役", "status": "reviewed",
    "text": "這一宮講的是你在人群裡的位置。你比較常被人找，還是比較常去找人。" },
  { "id": "frame.close.僕役.4", "kind": "close", "palace": "僕役", "status": "reviewed",
    "text": "留給你自己驗證：一段交情淡下來的時候，你通常會不會主動接回來。" },

  { "id": "frame.close.官祿.1", "kind": "close", "palace": "官祿", "status": "reviewed",
    "text": "值得自己驗證的是：你做得最順的那段日子，順的是事情，還是身邊的人。" },
  { "id": "frame.close.官祿.2", "kind": "close", "palace": "官祿", "status": "reviewed",
    "text": "可以留意的是：你談自己的工作時，說的多數是成果，還是過程。" },
  { "id": "frame.close.官祿.3", "kind": "close", "palace": "官祿", "status": "reviewed",
    "text": "這一宮講的是做事的方式。你比較能忍的，是辛苦，還是沒有意思。" },
  { "id": "frame.close.官祿.4", "kind": "close", "palace": "官祿", "status": "reviewed",
    "text": "留一個問題給你自己：如果沒有人知道是你做的，這件工作你還會不會做到一樣。" },

  { "id": "frame.close.田宅.1", "kind": "close", "palace": "田宅", "status": "reviewed",
    "text": "值得自己看看：你回到家、關上門之後，通常要多久才真正放鬆下來。" },
  { "id": "frame.close.田宅.2", "kind": "close", "palace": "田宅", "status": "reviewed",
    "text": "可以留意的是：對你來說，家比較像一個地方，還是比較像那幾個人。" },
  { "id": "frame.close.田宅.3", "kind": "close", "palace": "田宅", "status": "reviewed",
    "text": "這一宮講的是你與空間的關係。你住的地方，有多少是你自己選的。" },
  { "id": "frame.close.田宅.4", "kind": "close", "palace": "田宅", "status": "reviewed",
    "text": "留給你自己驗證：搬動一次之後，你要多久才覺得那裡是自己的。" },

  { "id": "frame.close.福德.1", "kind": "close", "palace": "福德", "status": "reviewed",
    "text": "值得自己想的是：你安靜下來的時候，是覺得舒服，還是有點難受。" },
  { "id": "frame.close.福德.2", "kind": "close", "palace": "福德", "status": "reviewed",
    "text": "可以留意的是：你讓自己享受一件事之前，是不是總要先找一個理由。" },
  { "id": "frame.close.福德.3", "kind": "close", "palace": "福德", "status": "reviewed",
    "text": "這一宮講的是內在安放自己的方式。你最近一次覺得夠了，是什麼時候。" },
  { "id": "frame.close.福德.4", "kind": "close", "palace": "福德", "status": "reviewed",
    "text": "留一個問題給你自己：你喜歡的東西裡，有多少是真喜歡，有多少是習慣。" },

  { "id": "frame.close.父母.1", "kind": "close", "palace": "父母", "status": "reviewed",
    "text": "值得自己看看：面對長輩的時候，你是先聽完，還是先想著怎麼回。" },
  { "id": "frame.close.父母.2", "kind": "close", "palace": "父母", "status": "reviewed",
    "text": "可以留意的是：你不喜歡的那種權威方式，你自己有沒有用過。" },
  { "id": "frame.close.父母.3", "kind": "close", "palace": "父母", "status": "reviewed",
    "text": "這一宮講的是你與規矩的相處。你守規矩的時候，多數是同意，還是省事。" },
  { "id": "frame.close.父母.4", "kind": "close", "palace": "父母", "status": "reviewed",
    "text": "留給你自己驗證：你和上一輩之間能談的話題，這幾年是多了還是少了。" }
]
