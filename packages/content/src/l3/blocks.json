[
  {
    "id": "l3.sanfang.命宮.pressure",
    "kind": "sanfang",
    "key": "命宮",
    "variant": "pressure",
    "body": "命宮的三方四正見多顆煞曜。這說的是條件，不是本質：你要做成一件事，通常得先處理一批不在計畫內的東西。基調本身沒有變，變的是達成它要繞幾個彎。",
    "rule_ids": [
      "sanfang.命宮-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.兄弟.pressure",
    "kind": "sanfang",
    "key": "兄弟",
    "variant": "pressure",
    "body": "兄弟宮的三方四正見多顆煞曜。平輩之間的來往條件較多，話說到哪一層、幫到哪一步，往往要各自拿捏。這描述的是相處的成本，不是誰對誰錯。",
    "rule_ids": [
      "sanfang.兄弟-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.夫妻.pressure",
    "kind": "sanfang",
    "key": "夫妻",
    "variant": "pressure",
    "body": "夫妻宮的三方四正見多顆煞曜。親密關係裡需要交代的事情比較多，節奏也容易被外面的事情打斷。這說的是相處的條件，不是這段關係的成敗。",
    "rule_ids": [
      "sanfang.夫妻-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.子女.pressure",
    "kind": "sanfang",
    "key": "子女",
    "variant": "pressure",
    "body": "子女宮的三方四正見多顆煞曜。你在培育一件事或一個人的時候，中途要處理的變數比較多，放手的時機不容易剛好。這說的是過程，不涉及生育這件事。",
    "rule_ids": [
      "sanfang.子女-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.財帛.pressure",
    "kind": "sanfang",
    "key": "財帛",
    "variant": "pressure",
    "body": "財帛宮的三方四正見多顆煞曜。資源進出的條件較多，來路和去路往往不在同一條線上。這說的是錢的流動方式，不是多少，也不能拿去做買賣判斷。",
    "rule_ids": [
      "sanfang.財帛-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.疾厄.pressure",
    "kind": "sanfang",
    "key": "疾厄",
    "variant": "pressure",
    "body": "疾厄宮的三方四正見多顆煞曜。這裡只讀負荷的形狀：你身上同時扛著的事情條件較多，回氣的空檔不容易連在一起。此處不涉病名，也不作任何風險分級。",
    "rule_ids": [
      "sanfang.疾厄-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.遷移.pressure",
    "kind": "sanfang",
    "key": "遷移",
    "variant": "pressure",
    "body": "遷移宮的三方四正見多顆煞曜。在陌生的環境裡要應付的條件較多，離開熟悉的地方之後，重新架起節奏往往要花時間。這說的是適應，不是吉凶。",
    "rule_ids": [
      "sanfang.遷移-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.僕役.pressure",
    "kind": "sanfang",
    "key": "僕役",
    "variant": "pressure",
    "body": "交友宮的三方四正見多顆煞曜。人群裡的來往條件較多，親疏的界線不容易一次劃清。這描述的是圈子的結構，不指認任何一個具體的人。",
    "rule_ids": [
      "sanfang.僕役-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.官祿.pressure",
    "kind": "sanfang",
    "key": "官祿",
    "variant": "pressure",
    "body": "官祿宮的三方四正見多顆煞曜。做事這件事在你這裡條件較多：要成一件事，往往得先把不相干的東西擺平。這說的是過程，不是能力，也不預測職位。",
    "rule_ids": [
      "sanfang.官祿-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.田宅.pressure",
    "kind": "sanfang",
    "key": "田宅",
    "variant": "pressure",
    "body": "田宅宮的三方四正見多顆煞曜。與住的地方、與家的關係條件較多，要安頓下來通常不是一次到位。這說的是安頓的過程，不等同於買不買樓。",
    "rule_ids": [
      "sanfang.田宅-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.福德.pressure",
    "kind": "sanfang",
    "key": "福德",
    "variant": "pressure",
    "body": "福德宮的三方四正見多顆煞曜。內在安放自己的條件較多，想要靜下來，往往要先把幾件事放好。這只作反思題目，不作任何臨床判斷。",
    "rule_ids": [
      "sanfang.福德-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
