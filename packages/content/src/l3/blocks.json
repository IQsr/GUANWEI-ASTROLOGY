[
  {
    "id": "l3.sanfang.命宮.pressure",
    "kind": "sanfang",
    "key": "命宮",
    "variant": "pressure",
    "body": "命宮的三方四正見多顆煞曜。你要做成一件事，通常得先處理一批不在計畫內的東西。基調本身沒有變，變的是達成它要繞幾個彎。",
    "rule_ids": [
      "sanfang.命宮-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.兄弟.pressure",
    "kind": "sanfang",
    "key": "兄弟",
    "variant": "pressure",
    "body": "兄弟宮的三方四正見多顆煞曜。和兄弟朋輩之間，話說到哪一層、幫到哪一步，往往要各自拿捏；一起做事之前，先講清楚分工比較好。",
    "rule_ids": [
      "sanfang.兄弟-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.夫妻.pressure",
    "kind": "sanfang",
    "key": "夫妻",
    "variant": "pressure",
    "body": "夫妻宮的三方四正見多顆煞曜。親密關係裡需要交代的事情比較多，節奏也容易被外面的事情打斷。",
    "rule_ids": [
      "sanfang.夫妻-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.子女.pressure",
    "kind": "sanfang",
    "key": "子女",
    "variant": "pressure",
    "body": "子女宮的三方四正見多顆煞曜。你在培育一件事或一個人的時候，中途要處理的變數比較多，放手的時機不容易剛好。",
    "rule_ids": [
      "sanfang.子女-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.財帛.pressure",
    "kind": "sanfang",
    "key": "財帛",
    "variant": "pressure",
    "body": "財帛宮的三方四正見多顆煞曜。你的錢進出不太整齊，收入來的時候，支出往往也同時找上門，留一筆備用比較安心。",
    "rule_ids": [
      "sanfang.財帛-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.疾厄.pressure",
    "kind": "sanfang",
    "key": "疾厄",
    "variant": "pressure",
    "body": "疾厄宮的三方四正見多顆煞曜。你常常同時扛著幾件事，想喘口氣，空檔卻很難連成一段。",
    "rule_ids": [
      "sanfang.疾厄-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.遷移.pressure",
    "kind": "sanfang",
    "key": "遷移",
    "variant": "pressure",
    "body": "遷移宮的三方四正見多顆煞曜。和人相處或許不難，真正花時間的，是離開熟悉的地方之後，重新架起你自己的生活節奏。",
    "rule_ids": [
      "sanfang.遷移-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.僕役.pressure",
    "kind": "sanfang",
    "key": "僕役",
    "variant": "pressure",
    "body": "僕役宮的三方四正見多顆煞曜。在人群裡，誰親誰疏不容易一次劃清，你的交情要慢慢看。",
    "rule_ids": [
      "sanfang.僕役-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.官祿.pressure",
    "kind": "sanfang",
    "key": "官祿",
    "variant": "pressure",
    "body": "官祿宮的三方四正見多顆煞曜。要做成一件事，你往往得先把一堆不相干的雜事擺平，才輪到正題。",
    "rule_ids": [
      "sanfang.官祿-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.田宅.pressure",
    "kind": "sanfang",
    "key": "田宅",
    "variant": "pressure",
    "body": "田宅宮的三方四正見多顆煞曜。你的住處和家裡的事，通常不是一次就安頓得好，搬動、修整會比預期多。",
    "rule_ids": [
      "sanfang.田宅-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.福德.pressure",
    "kind": "sanfang",
    "key": "福德",
    "variant": "pressure",
    "body": "福德宮的三方四正見多顆煞曜。想靜下來之前，你往往要先把手上幾件事放好，心才放得下。",
    "rule_ids": [
      "sanfang.福德-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.父母.pressure",
    "kind": "sanfang",
    "key": "父母",
    "variant": "pressure",
    "body": "父母宮的三方四正見多顆煞曜。與權威、與長輩之間要交代的事情比較多，規矩和自己的判斷不總是同一個方向。",
    "rule_ids": [
      "sanfang.父母-pressure.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.命宮.support",
    "kind": "sanfang",
    "key": "命宮",
    "variant": "support",
    "body": "命宮的三方四正見多顆吉曜。你想推一件事的時候，通常不必從最基本的地方開始鋪，起步比別人省力。",
    "rule_ids": [
      "sanfang.命宮-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.兄弟.support",
    "kind": "sanfang",
    "key": "兄弟",
    "variant": "support",
    "body": "兄弟宮的三方四正見多顆吉曜。你和平輩相處的方式照舊，只是要找人商量或者並肩做一件事，起手的門檻比較低。",
    "rule_ids": [
      "sanfang.兄弟-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.夫妻.support",
    "kind": "sanfang",
    "key": "夫妻",
    "variant": "support",
    "body": "夫妻宮的三方四正見多顆吉曜。感情裡你還是你，只是要談的事，比較容易找到合適的時機開口。",
    "rule_ids": [
      "sanfang.夫妻-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.子女.support",
    "kind": "sanfang",
    "key": "子女",
    "variant": "support",
    "body": "子女宮的三方四正見多顆吉曜。你在培育一件事或一個人的時候，手上可用的東西比較多，不必事事親力親為。",
    "rule_ids": [
      "sanfang.子女-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.財帛.support",
    "kind": "sanfang",
    "key": "財帛",
    "variant": "support",
    "body": "財帛宮的三方四正見多顆吉曜。資源的來路相對通，要張羅一件事的時候，可調動的東西比較多。",
    "rule_ids": [
      "sanfang.財帛-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.疾厄.support",
    "kind": "sanfang",
    "key": "疾厄",
    "variant": "support",
    "body": "疾厄宮的三方四正見多顆吉曜。你手上通常留得住一點餘力，不至於所有事情同時壓到底。",
    "rule_ids": [
      "sanfang.疾厄-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.遷移.support",
    "kind": "sanfang",
    "key": "遷移",
    "variant": "support",
    "body": "遷移宮的三方四正見多顆吉曜。你適應的步調照舊；不同的是，在外需要的人和資源比較容易找到。",
    "rule_ids": [
      "sanfang.遷移-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.僕役.support",
    "kind": "sanfang",
    "key": "僕役",
    "variant": "support",
    "body": "僕役宮的三方四正見多顆吉曜。人群裡的來往相對通，要接上一條線、找到一個人，路徑比較短。",
    "rule_ids": [
      "sanfang.僕役-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.官祿.support",
    "kind": "sanfang",
    "key": "官祿",
    "variant": "support",
    "body": "官祿宮的三方四正見多顆吉曜。你要推一件事，願意接手、肯幫忙的人通常找得到。",
    "rule_ids": [
      "sanfang.官祿-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.田宅.support",
    "kind": "sanfang",
    "key": "田宅",
    "variant": "support",
    "body": "田宅宮的三方四正見多顆吉曜。日常住處和家裡的事多半順手，你要安頓下來阻力比較小；這和家產守不守得住是兩回事。",
    "rule_ids": [
      "sanfang.田宅-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.福德.support",
    "kind": "sanfang",
    "key": "福德",
    "variant": "support",
    "body": "福德宮的三方四正見多顆吉曜。你安頓自己的方式照舊，但內在可以安放自己的地方比較多。",
    "rule_ids": [
      "sanfang.福德-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.sanfang.父母.support",
    "kind": "sanfang",
    "key": "父母",
    "variant": "support",
    "body": "父母宮的三方四正見多顆吉曜。和長輩、上司之間要交代一件事，你的路徑比較直接，不必繞圈。",
    "rule_ids": [
      "sanfang.父母-support.structural"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.命宮",
    "kind": "shen",
    "key": "命宮",
    "body": "你花力氣的方向，通常就是別人形容你的那個方向：先天的基調和後天著力的地方在同一處。",
    "rule_ids": [
      "structure.shen.命宮"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.夫妻",
    "kind": "shen",
    "key": "夫妻",
    "body": "你把力氣放在關係上：一段關係的狀態，容易帶動你整個人的狀態。",
    "rule_ids": [
      "structure.shen.夫妻"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.財帛",
    "kind": "shen",
    "key": "財帛",
    "body": "你把力氣放在資源上：處理實際的東西，是你安放自己的方式。",
    "rule_ids": [
      "structure.shen.財帛"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.遷移",
    "kind": "shen",
    "key": "遷移",
    "body": "你把力氣放在外面：在陌生的地方，比在熟悉的地方更用得上勁。",
    "rule_ids": [
      "structure.shen.遷移"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.官祿",
    "kind": "shen",
    "key": "官祿",
    "body": "你把力氣放在做事上：手上有沒有一件正在推的事，很大程度決定你的狀態。",
    "rule_ids": [
      "structure.shen.官祿"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.shen.福德",
    "kind": "shen",
    "key": "福德",
    "body": "你把力氣放在內在：安不安頓，比做成了甚麼更影響你的狀態。",
    "rule_ids": [
      "structure.shen.福德"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.命宮",
    "kind": "empty",
    "key": "命宮",
    "body": "你給人的印象很看場合：換一個環境，別人看到的你可以差得很遠。",
    "rule_ids": [
      "structure.empty.命宮"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.兄弟",
    "kind": "empty",
    "key": "兄弟",
    "body": "你和平輩相處的樣子，多半跟著你身處的圈子變：換一個圈子，往來的方式也跟著換。",
    "rule_ids": [
      "structure.empty.兄弟"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.夫妻",
    "kind": "empty",
    "key": "夫妻",
    "body": "你在感情裡的狀態，常常跟著工作走：手上的事順，相處也順；工作一忙亂，感情就容易被擠到一邊。",
    "rule_ids": [
      "structure.empty.夫妻"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.子女",
    "kind": "empty",
    "key": "子女",
    "body": "你怎樣帶後輩、怎樣做自己的作品，多半看你的生活安不安頓：家裡穩，你才有心思放在這些事上。",
    "rule_ids": [
      "structure.empty.子女"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.財帛",
    "kind": "empty",
    "key": "財帛",
    "body": "你怎樣用錢，多半看你想過怎樣的日子：先想清楚想要的生活，錢的安排就跟著定下來。",
    "rule_ids": [
      "structure.empty.財帛"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.疾厄",
    "kind": "empty",
    "key": "疾厄",
    "body": "你身上的壓力，多半來自外面的要求：上司、家人要求多的時期，你就特別累。",
    "rule_ids": [
      "structure.empty.疾厄"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.遷移",
    "kind": "empty",
    "key": "遷移",
    "body": "你出門在外和在家差不多，不會換一副面孔；陌生人看到的，就是熟人認識的你。",
    "rule_ids": [
      "structure.empty.遷移"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.僕役",
    "kind": "empty",
    "key": "僕役",
    "body": "你在朋友、同事之間的位置，多半沿用你和兄弟姊妹、同輩相處的那一套。",
    "rule_ids": [
      "structure.empty.僕役"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.官祿",
    "kind": "empty",
    "key": "官祿",
    "body": "你做事順不順，很受身邊最親近那個人影響：關係穩定的時候，工作也比較穩。",
    "rule_ids": [
      "structure.empty.官祿"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.田宅",
    "kind": "empty",
    "key": "田宅",
    "body": "你對家的安排，多半跟著你想照顧、想培養的人和事走，例如為了家人或手上的作品調整住處。",
    "rule_ids": [
      "structure.empty.田宅"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.福德",
    "kind": "empty",
    "key": "福德",
    "body": "你的心安不安，多半繫在實際的東西上：錢夠不夠、事情有沒有著落，比想法更影響你。",
    "rule_ids": [
      "structure.empty.福德"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.empty.父母",
    "kind": "empty",
    "key": "父母",
    "body": "你和長輩、上司處得好不好，多半看你當時的負荷：自己忙不過來的時候，最容易和他們起摩擦。",
    "rule_ids": [
      "structure.empty.父母"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.junchen-qinghui",
    "kind": "geju",
    "key": "junchen-qinghui",
    "body": "這一組星形成君臣慶會：主導的一方和輔佐的一方同時到位。《全書》記這個組合，講的是有人可用，不是必然得位；能不能用得上，仍然在於你肯不肯讓人插手。",
    "rule_ids": [
      "geju.junchen-qinghui.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.fubi-jiadi",
    "kind": "geju",
    "key": "fubi-jiadi",
    "body": "這一組星形成輔弼夾帝：主導的位置左右都有支撐，結構是完整的。意思是站得穩，不是走得快；一個完整的結構同樣可以停在原地。",
    "rule_ids": [
      "geju.fubi-jiadi.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.kuiyue-tongxing",
    "kind": "geju",
    "key": "kuiyue-tongxing",
    "body": "這一組星形成魁鉞同行：機會和引薦容易出現，你做的事比較容易被看見。意思是可見度，不是評價；被看見和被認可是兩件事。",
    "rule_ids": [
      "geju.kuiyue-tongxing.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.rima-jiaochi",
    "kind": "geju",
    "key": "rima-jiaochi",
    "body": "這一組星形成祿馬交馳：資源跟著走動流轉，動起來比守著更容易得力。",
    "rule_ids": [
      "geju.rima-jiaochi.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.riligzhongtian",
    "kind": "geju",
    "key": "riligzhongtian",
    "body": "這一組星形成日麗中天：照得出去，位置顯眼，你做的事不容易無聲無息。意思是可見度高，代價是同樣看得見的，還有沒做好的部分。",
    "rule_ids": [
      "geju.riligzhongtian.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.shuicheng-guie",
    "kind": "geju",
    "key": "shuicheng-guie",
    "body": "這一組星形成水澄桂萼：收納得地，積累的過程比較順。意思是累積這件事對你不費力，但累積和用得上，中間還隔著一步。",
    "rule_ids": [
      "geju.shuicheng-guie.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.shanyin-chaogang",
    "kind": "geju",
    "key": "shanyin-chaogang",
    "body": "這一組星形成善蔭朝綱：轉圜的餘地和照顧他人的傾向並存。意思是你手上通常留得住一條路，但那條路多數也留給了別人。",
    "rule_ids": [
      "geju.shanyin-chaogang.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.cai-ju-caiwei",
    "kind": "geju",
    "key": "cai-ju-caiwei",
    "body": "這一組星形成財居財位：處理資源這件事在本位上，做起來順手。意思是手感，不是數目；順手的人一樣可以把事情做得太滿。",
    "rule_ids": [
      "geju.cai-ju-caiwei.core"
    ],
    "status": "reviewed"
  },
  {
    "id": "l3.geju.gui-ru-guixiang",
