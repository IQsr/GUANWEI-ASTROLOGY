      "regex": [
        {
          "id": "F3-pct",
          "re": "\\d{1,3}\\s*%",
          "why": "面向讀者嘅文字唔准出現百分比 —— 佢會被讀成事件概率"
        },
        {
          "id": "F3-age",
          "re": "(活到|去到|捱到)\\s*\\d{1,3}\\s*歲",
          "why": "壽命推斷"
        }
      ]
    },
    {
      "id": "F4",
      "name": "事件偷渡",
      "spec": "§3.4",
      "reason": "加咗模糊詞仍然係禁止嘅事件推斷。「可能」唔係免責，係偷渡。",
      "regex": [
        {
          "id": "F4-hedge",
          "re": "(可能|恐怕|恐有|或有|大概|多數|似乎|怕且)[^。；！？]{0,10}(癌|腫瘤|中風|心臟|手術|住院|喪|離婚|破產|車禍|意外|坐牢|流產|不孕|外遇)",
          "why": "模糊詞 + 禁止事件 = 仍然係事件推斷"
        }
      ]
    },
