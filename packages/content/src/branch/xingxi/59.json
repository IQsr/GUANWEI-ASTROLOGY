  "rules": [
    {
      "id": "天相卯酉.有原則",
      "role": "refine",
      "when": {
        "lean": "有原則"
      },
      "text": "有原則的你，照顧朋友也有自己的分寸，不會變成老好人。",
      "en": "Principled, you look after friends with your own sense of limits, and don't become a pushover.",
      "source": {
        "passage": "deep.星系59.2",
        "quote": "不会变成[老好人]"
      }
    },
    {
      "id": "天相卯酉.重情面",
      "role": "limit",
      "when": {
        "lean": "重情面"
      },
      "text": "重情面的一面較重：這不是只顧自己的私利，而是無原則地照顧友情，有時只為了義氣。",
      "en": "The loyalty-first side is stronger: not selfishness, but looking after friends without principle, sometimes purely out of loyalty.",
      "source": {
        "passage": "deep.星系59.3",
        "quote": "而徇私者则是无原则地照顾友情"
      }
    },
    {
      "id": "天相卯酉.火鈴",
      "role": "limit",
      "when": {
        "all": [
          {
            "star": [
              "火星",
              "鈴星"
            ],
            "at": "sifang"
          },
          {
            "not": {
              "lean": "重情面"
            }
          },
          {
            "not": {
              "star": [
                "地空",
                "地劫"
              ],
              "at": "same"
            }
          },
          {
            "not": {
              "hua": "忌",
              "star": "廉貞",
              "at": "opp"
            }
          }
        ]
      },
      "text": "會照的火鈴，令你帶重情面而失原則的色彩。",
      "en": "Huo or Ling meeting your chart adds a tendency to put loyalty above principle.",
      "pole": "重情面",
      "source": {
        "passage": "deep.星系59.4",
        "quote": "冲则有徇私的色彩"
      }
    },
    {
      "id": "天相卯酉.空劫",
      "role": "limit",
      "when": {
        "all": [
          {
            "star": [
              "地空",
              "地劫"
            ],
            "at": "same"
          },
          {
            "not": {
              "lean": "重情面"
            }
          }
        ]
      },
      "text": "你的命宮有空劫，也容易重情面而失原則。",
      "en": "Kong or Jie in your Life Palace also leans you towards loyalty over principle.",
      "pole": "重情面",
      "source": {
        "passage": "deep.星系59.5",
        "quote": "亦主徇私"
      }
    },
    {
      "id": "天相卯酉.吉星",
      "role": "refine",
      "when": {
        "star": [
          "左輔",
          "右弼",
          "文昌",
          "文曲",
          "天魁",
          "天鉞"
        ],
        "at": "sifang"
      },
      "text": "有〔輔佐吉星〕會合，你正直的本性得以發揮。",
      "en": "〔Supporting stars〕 meeting your chart let your upright nature come through.",
      "pole": "有原則",
      "source": {
        "passage": "deep.星系59.6",
        "quote": "则此二宫垣的天相便正直之性"
      }
    },
