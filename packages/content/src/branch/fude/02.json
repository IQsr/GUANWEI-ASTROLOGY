      "天府"
    ]
  },
  "rules": [
    {
      "id": "福德.紫府.朝拱",
      "role": "refine",
      "when": {
        "all": [
          {
            "star": [
              "左輔",
              "右弼"
            ],
            "at": "sifang"
          },
          {
            "star": [
              "天魁",
              "天鉞"
            ],
            "at": "sifang"
          }
        ]
      },
      "text": "紫微天府得〔吉星〕拱照，你福厚，為人寬厚大度。",
      "en": "Zi Wei with Tian Fu, surrounded by helper stars: you are fortunate, generous and broad-minded.",
      "source": {
        "passage": "deep.福德.紫微.4",
        "quote": "有吉曜朝拱则福厚，且宽厚大度"
      }
    },
    {
      "id": "福德.紫府.無吉",
      "role": "limit",
      "when": {
        "not": {
          "any": [
            {
              "star": [
                "左輔",
                "右弼"
              ],
              "at": "sifang"
            },
            {
              "star": [
                "天魁",
                "天鉞"
              ],
              "at": "sifang"
            }
          ]
        }
      },
      "text": "紫微天府不見吉星，你較為勞心，心思少有歇息。",
      "en": "Zi Wei–Tian Fu meets no helper stars: you are mentally hard-worked, and your mind seldom rests.",
      "source": {
        "passage": "deep.福德.紫微.5",
        "quote": "无则劳心"
      }
    },
    {
      "id": "福德.紫府.化",
      "role": "refine",
      "when": {
        "any": [
          {
            "hua": "科",
            "star": "紫微",
            "at": "same"
          },
          {
            "hua": "權",
            "star": "紫微",
            "at": "same"
          },
          {
            "hua": "科",
            "star": "天府",
            "at": "same"
          }
        ]
      },
      "text": "紫微或天府化科化權，你的自尊心很重。",
      "en": "With Zi Wei or Tian Fu in Merit or Authority, your self-respect runs very deep.",
      "source": {
        "passage": "deep.福德.紫微.6",
        "quote": "[紫府]化科、化权，自尊心极重"
      }
    }
