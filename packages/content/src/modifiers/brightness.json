        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.太陽.不",
    "kind": "brightness",
    "star": "太陽",
    "key": "不",
    "text": "將落未落：想照而力不繼，容易在無人回應的地方空轉。要留意它在哪些地方白費了力氣。",
    "sources": [
      {
        "corpus": "quanshu",
