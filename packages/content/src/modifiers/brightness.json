  {
    "id": "mod.brightness.太陽.廟旺",
    "kind": "brightness",
    "star": "太陽",
    "key": "廟旺",
    "text": "日麗中天：照得出去，也被看得見，付出有人接得住。它的付出這時候收得到回應。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.太陽",
        "quote": "太陽星屬火，日之精也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "太阳属火南北斗化贵为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.太陽.得利",
    "kind": "brightness",
    "star": "太陽",
    "key": "得利",
    "text": "仍然向外，但範圍縮小，照顧得到身邊而未必照顧得到場面。範圍縮小了，重心要跟著調整。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.太陽",
        "quote": "太陽星屬火，日之精也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "太阳属火南北斗化贵为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.太陽.平",
    "kind": "brightness",
    "star": "太陽",
    "key": "平",
    "text": "光度平常：願意給，給出去的分量卻不特別顯眼。分量平常，不必寫成特別顯眼。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.太陽",
        "quote": "太陽星屬火，日之精也",
