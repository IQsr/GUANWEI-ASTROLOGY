[
  {
    "id": "mod.brightness.紫微.廟旺",
    "kind": "brightness",
    "star": "紫微",
    "key": "廟旺",
    "text": "主導的姿態站得住：說了算，也扛得起，旁人願意讓位給它。方向不必打折，但仍要看身邊有沒有輔佐。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.紫微",
        "quote": "紫微屬土，乃中天之尊星為帝座",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "紫微属土中天星南北斗化帝座为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.紫微.得利",
    "kind": "brightness",
    "star": "紫微",
    "key": "得利",
    "text": "主導仍在，但要靠場合配合；位置不對時它會收起來不說。要判斷它，先看它有沒有可以指揮的東西。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.紫微",
        "quote": "紫微屬土，乃中天之尊星為帝座",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "紫微属土中天星南北斗化帝座为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.紫微.平",
    "kind": "brightness",
    "star": "紫微",
    "key": "平",
    "text": "標準還在，推動的力氣不足，多半停在提出意見的階段。讀這一檔要把預期由主導調成參與。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.紫微",
        "quote": "紫微屬土，乃中天之尊星為帝座",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "紫微属土中天星南北斗化帝座为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.紫微.不",
    "kind": "brightness",
    "star": "紫微",
    "key": "不",
    "text": "想主導而使不上力，容易變成對細節反覆要求。要留意它把力氣花在了哪些小事上。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.紫微",
        "quote": "紫微屬土，乃中天之尊星為帝座",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "紫微属土中天星南北斗化帝座为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.紫微.陷",
    "kind": "brightness",
    "star": "紫微",
    "key": "陷",
    "text": "帝座失位：標準不減，可以支配的東西卻很少。讀這一檔要把重點放在落差，而不是放在能力。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.紫微",
        "quote": "紫微屬土，乃中天之尊星為帝座",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "紫微属土中天星南北斗化帝座为官禄主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天機.廟旺",
    "kind": "brightness",
    "star": "天機",
    "key": "廟旺",
    "text": "機變用得上：轉圜快、路數多，難題到它手上通常有第二條路。可以放心把它當作解法的來源。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天機",
        "quote": "天機屬木，南斗第三益算之善星也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天机属木南斗化善为兄弟主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天機.得利",
    "kind": "brightness",
    "star": "天機",
    "key": "得利",
    "text": "轉得動，但要時間；倉促之下它的方案未必比直來直往好。要給它時間，倉促之下反而不準。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天機",
        "quote": "天機屬木，南斗第三益算之善星也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天机属木南斗化善为兄弟主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天機.平",
    "kind": "brightness",
    "star": "天機",
    "key": "平",
    "text": "想得多而落實少，選項列得出，決定下不了。讀它時重點放在想法而不是結果。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天機",
        "quote": "天機屬木，南斗第三益算之善星也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天机属木南斗化善为兄弟主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天機.不",
    "kind": "brightness",
    "star": "天機",
    "key": "不",
    "text": "機變轉成搖擺，同一件事反覆改口，旁人抓不住。它的反覆不是不在乎，是選項太多。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天機",
        "quote": "天機屬木，南斗第三益算之善星也",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天机属木南斗化善为兄弟主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天機.陷",
    "kind": "brightness",
    "star": "天機",
    "key": "陷",
    "text": "《全書》明寫「陷地無力」：想得再多都缺一個可以施展的空間。要看它身邊有沒有可以合作的人。",
    "sources": [
