  {
    "id": "mod.brightness.天同.廟旺",
    "kind": "brightness",
    "star": "天同",
    "key": "廟旺",
    "text": "福氣厚：日子過得舒服，人緣寬，不必用力也有人願意幫。它的舒服是真的，不必替它擔心。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天同",
        "quote": "天同星屬水，乃南方第四星也，為福德宮之主宰",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天同属水金南斗化福为福德主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天同.得利",
    "kind": "brightness",
    "star": "天同",
    "key": "得利",
    "text": "安穩仍在，但需要條件配合；順的時候特別順，緊的時候拖得住。順與緊的落差要一併寫出來。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天同",
        "quote": "天同星屬水，乃南方第四星也，為福德宮之主宰",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天同属水金南斗化福为福德主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天同.平",
    "kind": "brightness",
    "star": "天同",
    "key": "平",
    "text": "不好不壞：既沒有推力，也沒有阻力。要留意它停留的時間會比自己以為的長很多。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天同",
        "quote": "天同星屬水，乃南方第四星也，為福德宮之主宰",
        "scope": "star"
      },
      {
        "corpus": "quanshu",
        "passage_id": "attrs.table",
        "quote": "天同属水金南斗化福为福德主",
        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.天同.不",
    "kind": "brightness",
    "star": "天同",
    "key": "不",
    "text": "安逸變成惰性：知道該動而遲遲不動，理由永遠找得到。這一檔的難處不在能力，在起步。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.天同",
        "quote": "天同星屬水，乃南方第四星也，為福德宮之主宰",
