        "scope": "star"
      }
    ],
    "status": "reviewed"
  },
  {
    "id": "mod.brightness.太陽.陷",
    "kind": "brightness",
    "star": "太陽",
    "key": "陷",
    "text": "失輝：付出轉向內裡，熱度還在而照不出去。做了很多卻沒有人知道，是這一檔最實在的處境。",
    "sources": [
      {
        "corpus": "quanshu",
        "passage_id": "star.太陽",
        "quote": "太陽星屬火，日之精也",
