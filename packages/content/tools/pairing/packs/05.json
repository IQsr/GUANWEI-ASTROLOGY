    {
     "id": "A.盤.夫妻宮",
     "kind": "盤面",
     "text": "夫妻宮在午，天梁",
     "cite": "命盤"
    },
    {
     "id": "A.盤.命宮",
     "kind": "盤面",
     "text": "命宮在申，沒有主星",
     "cite": "命盤"
    },
    {
     "id": "A.感情.結論",
     "kind": "在感情裡",
     "text": "你在感情裡自然站在照顧和承擔的一方。",
     "cite": "《全書》卷二〈三妻妾〉"
    },
    {
     "id": "A.感情.留意",
     "kind": "在感情裡",
     "text": "要留意的是：你少把自己的需要放上檯面，對方感到被照顧，卻未必被需要。",
     "cite": "《全書》卷二〈三妻妾〉"
    },
    {
     "id": "A.命宮.骨架",
     "kind": "性格",
     "text": "你的命宮在申，宮內沒有主星，借對面遷移宮的天機、太陰來讀。天機太陰同宮，財帛宮、官祿宮是天梁與天同：天梁代表理智，天同代表情緒。天機太陰本身吉化，只代表格局高，不決定你偏哪一邊。",
     "cite": "《深造講義》p.159"
    },
    {
     "id": "A.命宮.長處",
     "kind": "性格",
     "text": "你的長處是敏銳，看得到別人看不到的細節。",
     "cite": "《深造講義》p.159"
    }
   ],
