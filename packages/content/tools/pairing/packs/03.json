    {
     "id": "A.盤.命宮",
     "kind": "盤面",
     "text": "命宮在丑，沒有主星",
     "cite": "命盤"
    },
    {
     "id": "A.感情.結論",
     "kind": "在感情裡",
     "text": "你在感情裡想得多、調整得快，願意為對方改變做法。",
     "cite": "《全書》卷二〈三妻妾〉"
    },
    {
     "id": "A.感情.留意",
     "kind": "在感情裡",
     "text": "要留意的是：你的想法變得快，對方有時會覺得抓不住你。",
     "cite": "《全書》卷二〈三妻妾〉"
    },
    {
     "id": "A.命宮.骨架",
     "kind": "性格",
     "text": "你的命宮在丑，宮內沒有主星，借對面遷移宮的天同、巨門來讀。巨門是暗曜，天同是情緒之星，兩者同宮，感情與情緒帶著一層陰影。財帛宮、官祿宮那邊太陽的光能照開這層陰影，照得開多少，決定你是明朗還是陰暗。在未宮，太陽的光較弱，這層陰影較難照開。",
     "cite": "《深造講義》p.56"
    },
    {
     "id": "A.命宮.長處",
     "kind": "性格",
     "text": "你的長處是經得起風浪，波折之後往往能白手做出局面。",
     "cite": "《深造講義》p.56"
    }
